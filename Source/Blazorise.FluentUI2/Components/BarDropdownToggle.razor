@inherits Blazorise.BarDropdownToggle
@if ( ParentBarDropdownState?.Mode == BarMode.Horizontal )
{
    @if ( HasNavigationTarget )
    {
        <div @ref="@ElementRef" id="@ElementId" class="@ClassNames fui-NavigationBar__splitItem" style="@StyleNames" @onfocusin="@ParentBarDropdown.OnFocusInHandler" @onfocusout="@ParentBarDropdown.OnFocusOutHandler" @onmouseenter="@ParentBarDropdown.OnMouseEnterHandler" @onmouseleave="@ParentBarDropdown.OnMouseLeaveHandler">
            <a href="@(IsDisabled ? null : GetTo())" rel="@GetRel()" target="@TargetName" title="@Title" class="fui-NavigationBar__splitItemLink @(Active ? "fui-Link-active" : null)" role="@SplitNavigationRole" aria-current="@AriaCurrentString" aria-disabled="@(IsDisabled ? "true" : null)" @onclick="@NavigationClickHandler" @onclick:preventDefault="@(IsDisabled || ShouldPreventDefaultOnToggleClick)" @onkeydown="@KeyDownHandler" @attributes="@Attributes">
                @ChildContent
            </a>
            <button type="button" class="fui-NavigationBar__splitItemButton" disabled="@IsDisabled" tabindex="0" aria-label="@ToggleAriaLabel" aria-haspopup="@AriaHasPopup" aria-expanded="@AriaExpanded" @onclick="@ToggleButtonClickHandler" @onkeydown="@ToggleButtonKeyDownHandler">
                <span class="fui-NavigationBar__toggleIcon fui-NavigationBar__toggleIcon--split @(ParentBarDropdown.IsBarDropdownSubmenu ? "fui-NavigationBar__toggleIcon--submenu" : null)">
                    @if ( ParentBarDropdown.IsBarDropdownSubmenu )
                    {
                        <svg fill="currentColor" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.65 4.15c.2-.2.5-.2.7 0l5.49 5.46c.21.22.21.57 0 .78l-5.49 5.46a.5.5 0 0 1-.7-.7L12.8 10 7.65 4.85a.5.5 0 0 1 0-.7Z" fill="currentColor"></path>
                        </svg>
                    }
                    else
                    {
                        <svg fill="currentColor" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15.85 7.65c.2.2.2.5 0 .7l-5.46 5.49a.55.55 0 0 1-.78 0L4.15 8.35a.5.5 0 1 1 .7-.7L10 12.8l5.15-5.16c.2-.2.5-.2.7 0Z" fill="currentColor"></path>
                        </svg>
                    }
                </span>
            </button>
        </div>
    }
    else
    {
        <button @ref="@ElementRef" id="@ElementId" type="button" class="@ClassNames" style="@StyleNames" disabled="@IsDisabled" tabindex="0" role="@ToggleRole" aria-haspopup="@AriaHasPopup" aria-expanded="@AriaExpanded" @onclick="@ClickHandler" @onkeydown="@KeyDownHandler" @onfocusin="@ParentBarDropdown.OnFocusInHandler" @onfocusout="@ParentBarDropdown.OnFocusOutHandler" @attributes="@Attributes" @onmouseenter="@ParentBarDropdown.OnMouseEnterHandler" @onmouseleave="@ParentBarDropdown.OnMouseLeaveHandler">
            <span>@ChildContent</span>
            @if ( IsToggleIconVisible )
            {
                <span class="fui-NavigationBar__toggleIcon @(ParentBarDropdown.IsBarDropdownSubmenu ? "fui-NavigationBar__toggleIcon--submenu" : null)">
                    @if ( ParentBarDropdown.IsBarDropdownSubmenu )
                    {
                        <svg fill="currentColor" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.65 4.15c.2-.2.5-.2.7 0l5.49 5.46c.21.22.21.57 0 .78l-5.49 5.46a.5.5 0 0 1-.7-.7L12.8 10 7.65 4.85a.5.5 0 0 1 0-.7Z" fill="currentColor"></path>
                        </svg>
                    }
                    else
                    {
                        <svg fill="currentColor" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15.85 7.65c.2.2.2.5 0 .7l-5.46 5.49a.55.55 0 0 1-.78 0L4.15 8.35a.5.5 0 1 1 .7-.7L10 12.8l5.15-5.16c.2-.2.5-.2.7 0Z" fill="currentColor"></path>
                        </svg>
                    }
                </span>
            }
        </button>
    }
}
else
{
    @if ( HasNavigationTarget )
    {
        <div @ref="@ElementRef" id="@ElementId" class="@ClassNames fui-NavCategoryItemSplit" style="@StyleNames" @onfocusin="@ParentBarDropdown.OnFocusInHandler" @onfocusout="@ParentBarDropdown.OnFocusOutHandler" @onmouseenter="@ParentBarDropdown.OnMouseEnterHandler" @onmouseleave="@ParentBarDropdown.OnMouseLeaveHandler">
            <a href="@(IsDisabled ? null : GetTo())" rel="@GetRel()" target="@TargetName" title="@Title" class="fui-NavCategoryItemSplit__link @(Active ? "fui-Link-active" : null)" role="@SplitNavigationRole" aria-current="@AriaCurrentString" aria-disabled="@(IsDisabled ? "true" : null)" @onclick="@NavigationClickHandler" @onclick:preventDefault="@(IsDisabled || ShouldPreventDefaultOnToggleClick)" @onkeydown="@KeyDownHandler" @attributes="@Attributes">
                <span class="@ToggleContentTextClassNames">@ChildContent</span>
            </a>
            <button type="button" class="fui-NavCategoryItemSplit__button" disabled="@IsDisabled" tabindex="0" title="@Title" aria-label="@ToggleAriaLabel" aria-haspopup="@AriaHasPopup" aria-expanded="@AriaExpanded" @onclick="@ToggleButtonClickHandler" @onkeydown="@ToggleButtonKeyDownHandler">
                @VerticalExpandIconTemplate
            </button>
        </div>
    }
    else
    {
        <button @ref="@ElementRef" id="@ElementId" type="button" class="@ClassNames" style="@StyleNames" disabled="@IsDisabled" tabindex="0" role="@ToggleRole" title="@Title" aria-label="@Title" aria-haspopup="@AriaHasPopup" aria-expanded="@AriaExpanded" @onclick="@ClickHandler" @onkeydown="@KeyDownHandler" @onfocusin="@ParentBarDropdown.OnFocusInHandler" @onfocusout="@ParentBarDropdown.OnFocusOutHandler" @attributes="@Attributes" @onmouseenter="@ParentBarDropdown.OnMouseEnterHandler" @onmouseleave="@ParentBarDropdown.OnMouseLeaveHandler">
            @VerticalIconTemplate
        </button>
    }
}
@code {
    protected RenderFragment VerticalExpandIconTemplate => __builder =>
    {
        @if ( IsToggleIconVisible )
        {
            <Span Class="@ToggleContentIconClassNames">
                <Span Class="@ToggleIconContainerClassNames">
                    <Span Class="@ExpandedToggleIconLayerClassNames">
                        <Icon Name="@ExpandedToggleIconName" IconSize="@ToggleIconSize" />
                    </Span>
                    <Span Class="@CollapsedToggleIconLayerClassNames">
                        <Icon Name="@CollapsedToggleIconName" IconSize="@ToggleIconSize" />
                    </Span>
                </Span>
            </Span>
        }
    };
}