@using System.Text
@inherits Blazorise.ColorPicker
@if ( ParentIsAddons )
{
    <div class="@AddonClassNames" style="@WrapperStyleNames" data-show-value="@ShowValueString">
        @InputElement
    </div>
}
else
{
    <div class="@InputClassNames" style="@WrapperStyleNames" data-show-value="@ShowValueString">
        @InputElement
    </div>
}
@ChildContent
@Feedback
@code {
    private RenderFragment InputElement => __builder =>
    {
        <span @ref="@ElementRef" id="@ElementId" name="@NameAttributeValue" class="@ClassNames" style="@StyleNames" value="@CurrentValueAsString" data-show-value="@ShowValueString" data-custom-preview="@CustomPreviewString" role="button" aria-haspopup="dialog" tabindex="@TabIndex" aria-disabled="@AriaDisabledString" aria-invalid="@AriaInvalid" aria-required="@ResolvedAriaRequired" aria-describedby="@AriaDescribedBy" aria-labelledby="@ResolvedAriaLabelledBy" @onchange="@OnChangeHandler" @onkeydown="@OnKeyDownHandler" @onkeypress="@OnKeyPressHandler" @onkeyup="@OnKeyUpHandler" @onblur="@OnBlurHandler" @onfocus="@OnFocusHandler" @onfocusin="@OnFocusInHandler" @onfocusout="@OnFocusOutHandler" @attributes="@Attributes">
            @if ( PreviewContent is not null )
            {
                @PreviewContent
            }
            else
            {
                <span class="@ColorPreviewClassNames"></span>
            }
            <span class="@ColorValueClassNames"></span>
        </span>
    };
}