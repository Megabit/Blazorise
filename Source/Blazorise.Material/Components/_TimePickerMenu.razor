@namespace Blazorise.Material.Components
@typeparam TValue
@inherits Blazorise._TimePickerMenu<TValue>
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Web

@if ( Parent.MenuVisible )
{
    @if ( !Parent.Inline )
    {
        <div class="@Menu.BackdropClassNames"
             aria-hidden="true"></div>
    }

    <div @ref="@MenuElementRef"
         id="@Parent.MenuId"
         class="@Menu.ClassNames"
         role="dialog"
         aria-modal="false"
         aria-labelledby="@($"{Parent.MenuId}-title")"
         aria-activedescendant="@Menu.FocusedPartId"
         tabindex="-1"
         @onkeydown="@Parent.OnMenuKeyDownAsync"
         @onkeydown:stopPropagation>
        <div id="@($"{Parent.MenuId}-title")" class="mui-time-picker-title">
            @Menu.TimeText
        </div>

        <div class="@Menu.ControlsClassNames" role="group" aria-label="@Menu.TimeText">
            <div class="@GetFieldClass( TimePickerPart.Hour )">
                <div class="mui-time-picker-input-control">
                    <input type="number"
                           id="@Menu.GetPartId( TimePickerPart.Hour )"
                           class="@Menu.InputClassNames"
                           min="@(Parent.TimeAs24hr ? 0 : 1)"
                           max="@(Parent.TimeAs24hr ? 23 : 12)"
                           step="@Menu.SafeHourIncrement"
                           value="@Menu.DisplayHourText"
                           aria-label="@Menu.HourText"
                           tabindex="0"
                           disabled="@Parent.MenuInteractionDisabled"
                           @onfocus="@(() => Parent.FocusPart( TimePickerPart.Hour ))"
                           @onkeydown="@((KeyboardEventArgs eventArgs) => Parent.OnControlKeyDownAsync( TimePickerPart.Hour, eventArgs ))"
                           @onkeydown:stopPropagation
                           @onchange="@Parent.ChangeHourAsync" />
                    @TimeButtons( TimePickerPart.Hour, Menu.HourText )
                </div>
                <span>@Menu.HourText</span>
            </div>

            <span class="@Menu.SeparatorClassNames" aria-hidden="true">:</span>

            <div class="@GetFieldClass( TimePickerPart.Minute )">
                <div class="mui-time-picker-input-control">
                    <input type="number"
                           id="@Menu.GetPartId( TimePickerPart.Minute )"
                           class="@Menu.InputClassNames"
                           min="0"
                           max="59"
                           step="@Menu.SafeMinuteIncrement"
                           value="@Menu.CurrentMinuteText"
                           aria-label="@Menu.MinuteText"
                           tabindex="0"
                           disabled="@Parent.MenuInteractionDisabled"
                           @onfocus="@(() => Parent.FocusPart( TimePickerPart.Minute ))"
                           @onkeydown="@((KeyboardEventArgs eventArgs) => Parent.OnControlKeyDownAsync( TimePickerPart.Minute, eventArgs ))"
                           @onkeydown:stopPropagation
                           @onchange="@Parent.ChangeMinuteAsync" />
                    @TimeButtons( TimePickerPart.Minute, Menu.MinuteText )
                </div>
                <span>@Menu.MinuteText</span>
            </div>

            @if ( Parent.Seconds )
            {
                <span class="@Menu.SeparatorClassNames" aria-hidden="true">:</span>

                <div class="@GetFieldClass( TimePickerPart.Second, true )">
                    <div class="mui-time-picker-input-control">
                        <input type="number"
                               id="@Menu.GetPartId( TimePickerPart.Second )"
                               class="@Menu.InputClassNames"
                               min="0"
                               max="59"
                               step="1"
                               value="@Menu.CurrentSecondText"
                               aria-label="@Menu.SecondText"
                               tabindex="0"
                               disabled="@Parent.MenuInteractionDisabled"
                               @onfocus="@(() => Parent.FocusPart( TimePickerPart.Second ))"
                               @onkeydown="@((KeyboardEventArgs eventArgs) => Parent.OnControlKeyDownAsync( TimePickerPart.Second, eventArgs ))"
                               @onkeydown:stopPropagation
                               @onchange="@Parent.ChangeSecondAsync" />
                        @TimeButtons( TimePickerPart.Second, Menu.SecondText )
                    </div>
                    <span>@Menu.SecondText</span>
                </div>
            }

            @if ( !Parent.TimeAs24hr )
            {
                <div id="@Menu.GetPartId( TimePickerPart.Meridiem )"
                     class="@PeriodClass"
                     role="group"
                     aria-label="@($"{Menu.AnteMeridiemText}/{Menu.PostMeridiemText}")">
                    <button type="button"
                            class="@GetPeriodClass( false )"
                            aria-pressed="@(!Menu.IsPostMeridiem)"
                            tabindex="0"
                            disabled="@Parent.MenuInteractionDisabled"
                            @onmousedown:preventDefault
                            @onfocus="@(() => Parent.FocusPart( TimePickerPart.Meridiem ))"
                            @onkeydown="@((KeyboardEventArgs eventArgs) => Parent.OnControlKeyDownAsync( TimePickerPart.Meridiem, eventArgs ))"
                            @onkeydown:stopPropagation
                            @onclick="@(() => SetMeridiemAsync( false ))">
                        @Menu.AnteMeridiemText
                    </button>
                    <button type="button"
                            class="@GetPeriodClass( true )"
                            aria-pressed="@Menu.IsPostMeridiem"
                            tabindex="0"
                            disabled="@Parent.MenuInteractionDisabled"
                            @onmousedown:preventDefault
                            @onfocus="@(() => Parent.FocusPart( TimePickerPart.Meridiem ))"
                            @onkeydown="@((KeyboardEventArgs eventArgs) => Parent.OnControlKeyDownAsync( TimePickerPart.Meridiem, eventArgs ))"
                            @onkeydown:stopPropagation
                            @onclick="@(() => SetMeridiemAsync( true ))">
                        @Menu.PostMeridiemText
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool focusApplied;

    private ElementReference MenuElementRef;

    private string GetFieldClass( TimePickerPart part, bool second = false )
        => $"mui-time-picker-field{( second ? " mui-time-picker-field-second" : null )} {Menu.GetControlClassNames( part )}";

    private string PeriodClass => $"mui-time-picker-period {Menu.MeridiemClassNames}";

    private string GetPeriodClass( bool postMeridiem )
        => $"mui-time-picker-period-button{( Menu.IsPostMeridiem == postMeridiem ? " mui-time-picker-period-button-selected" : null )}";

    private Task SetMeridiemAsync( bool postMeridiem )
        => Menu.IsPostMeridiem == postMeridiem
            ? Task.CompletedTask
            : Parent.ToggleMeridiemAsync();

    private RenderFragment TimeButtons( TimePickerPart part, string label ) => __builder =>
    {
        <div class="mui-time-picker-buttons">
            @foreach ( int direction in new[] { 1, -1 } )
            {
                <button @key="direction"
                        type="button"
                        class="mui-time-picker-button"
                        aria-label="@($"{( direction > 0 ? "Increment" : "Decrement" )} {label}")"
                        disabled="@Parent.MenuInteractionDisabled"
                        @onmousedown:preventDefault
                        @onfocus="@(() => Parent.FocusPart( part ))"
                        @onkeydown="@((KeyboardEventArgs eventArgs) => eventArgs.Key == "Escape" ? Parent.OnControlKeyDownAsync( part, eventArgs ) : Task.CompletedTask)"
                        @onkeydown:stopPropagation
                        @onclick="@(() => Parent.AdjustPartAsync( part, direction ))">
                    <Icon Name="@(direction > 0 ? IconName.AngleUp : IconName.AngleDown)" aria-hidden="true" />
                </button>
            }
        </div>
    };

    protected override async Task OnAfterRenderAsync( bool firstRender )
    {
        if ( Parent.MenuVisible && !Parent.Inline )
        {
            if ( Parent.FocusMenuOnOpen && !focusApplied )
            {
                focusApplied = true;
                await MenuElementRef.FocusAsync( preventScroll: true );
            }
            else if ( !Parent.FocusMenuOnOpen )
            {
                focusApplied = false;
            }
        }
        else
        {
            focusApplied = false;
        }
    }
}