@namespace Blazorise.Material.Components
@typeparam TValue
@inherits Blazorise._DatePickerCalendar<TValue>
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Web

@if ( Parent.CalendarVisible )
{
    @if ( !Parent.Inline )
    {
        <div class="@Calendar.BackdropClassNames"
             aria-hidden="true"></div>
    }

    <div @ref="@CalendarElementRef"
         id="@Parent.CalendarId"
         class="@Calendar.ClassNames"
         role="dialog"
         aria-modal="false"
         aria-labelledby="@($"{Parent.CalendarId}-title")"
         aria-activedescendant="@(Parent.InputMode == DateInputMode.Month ? Calendar.GetMonthId( Calendar.FocusedDate ) : Calendar.GetDayId( Calendar.FocusedDate ))"
         tabindex="-1"
         @onkeydown="@Parent.OnCalendarKeyDownAsync"
         @onkeydown:stopPropagation>
        <div class="mui-date-picker-date-pane">
            <div class="@Calendar.HeaderClassNames">
                <div id="@($"{Parent.CalendarId}-title")"
                     class="@Calendar.TitleClassNames"
                     aria-live="polite">
                    @if ( Parent.InputMode != DateInputMode.Month )
                    {
                        <label class="mui-date-picker-selector">
                            <span class="mui-date-picker-selector-label">@Calendar.MonthText</span>
                            <select value="@Calendar.VisibleMonthNumber"
                                    aria-label="@Calendar.MonthText"
                                    tabindex="0"
                                    disabled="@Parent.CalendarInteractionDisabled"
                                    @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                                    @onkeydown:stopPropagation
                                    @onchange="@Parent.ChangeVisibleMonth">
                                @for ( int monthIndex = 0; monthIndex < Calendar.MonthNames.Length; monthIndex++ )
                                {
                                    <option value="@(monthIndex + 1)">@Calendar.MonthNames[monthIndex]</option>
                                }
                            </select>
                        </label>
                    }

                    <label class="mui-date-picker-selector mui-date-picker-year-selector">
                        <span class="mui-date-picker-selector-label">@Calendar.YearText</span>
                        <input type="number"
                               min="1"
                               max="9999"
                               value="@Calendar.VisibleMonthYear"
                               aria-label="@Calendar.YearText"
                               tabindex="0"
                               disabled="@Parent.CalendarInteractionDisabled"
                               @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                               @onkeydown:stopPropagation
                               @onchange="@Parent.ChangeVisibleYear" />
                    </label>
                </div>

                <div class="mui-date-picker-navigation-group">
                    <button type="button"
                            class="@Calendar.NavigationClassNames"
                            aria-label="@Calendar.PreviousPeriodAriaLabel"
                            tabindex="0"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onmousedown:preventDefault
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onclick="@Parent.ShowPreviousPeriod">
                        <span aria-hidden="true">@Calendar.PreviousText</span>
                    </button>

                    <button type="button"
                            class="@Calendar.NavigationClassNames"
                            aria-label="@Calendar.NextPeriodAriaLabel"
                            tabindex="0"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onmousedown:preventDefault
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onclick="@Parent.ShowNextPeriod">
                        <span aria-hidden="true">@Calendar.NextText</span>
                    </button>
                </div>
            </div>

            @if ( Parent.InputMode == DateInputMode.Month )
            {
                <div class="@Calendar.MonthsClassNames"
                     role="grid"
                     aria-label="@Calendar.Label"
                     aria-activedescendant="@Calendar.GetMonthId( Calendar.FocusedDate )"
                     tabindex="0"
                     @onfocus="@HandleGridFocus"
                     @onblur="@HandleGridBlur">
                    @foreach ( DatePickerCalendarMonth month in Parent.BuildCalendarMonths() )
                    {
                        <button id="@Calendar.GetMonthId( month.Date )"
                                @key="@month.Date"
                                type="button"
                                role="gridcell"
                                class="@GetMonthClassNames( month )"
                                aria-label="@($"{month.Name} {month.Date.Year}")"
                                aria-selected="@month.Selected"
                                disabled="@month.Disabled"
                                tabindex="-1"
                                @onmousedown:preventDefault
                                @onclick="@(() => Parent.SelectMonthAsync( month.Date ))">
                            @month.Name
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="@Calendar.GridClassNames"
                     role="grid"
                     aria-label="@Calendar.Label"
                     aria-activedescendant="@Calendar.GetDayId( Calendar.FocusedDate )"
                     tabindex="0"
                     @onfocus="@HandleGridFocus"
                     @onblur="@HandleGridBlur">
                    <div class="@Calendar.WeekdaysClassNames" role="row">
                        @if ( Parent.ShowWeekNumbers )
                        {
                            <span class="@Calendar.WeekNumberClassNames" role="columnheader">@Calendar.WeekText</span>
                        }
                        @foreach ( string weekday in Calendar.WeekdayNames )
                        {
                            <span class="@Calendar.WeekdayClassNames" role="columnheader">@weekday</span>
                        }
                    </div>

                    @foreach ( DatePickerCalendarWeek week in Parent.BuildCalendarWeeks() )
                    {
                        <div class="@Calendar.WeekClassNames" role="row">
                            @if ( Parent.ShowWeekNumbers )
                            {
                                <span class="@Calendar.WeekNumberClassNames" role="rowheader">@week.WeekNumber</span>
                            }
                            @foreach ( DatePickerCalendarDay day in week.Days )
                            {
                                <button id="@Calendar.GetDayId( day.Date )"
                                        @key="@day.Date"
                                        type="button"
                                        role="gridcell"
                                        class="@GetDayClassNames( day )"
                                        aria-label="@Calendar.GetDateAriaLabel( day.Date )"
                                        aria-selected="@day.Selected"
                                        aria-current="@(day.Today ? "date" : null)"
                                        disabled="@day.Disabled"
                                        tabindex="-1"
                                        @onmousedown:preventDefault
                                        @onmouseover="@(() => Parent.PreviewRange( day.Date ))"
                                        @onmouseout="@(() => Parent.PreviewRange( null ))"
                                        @onclick="@(() => Parent.SelectDateAsync( day.Date ))">
                                    @day.Date.Day
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if ( Parent.InputMode == DateInputMode.DateTime )
        {
            <div class="@Calendar.TimeClassNames" role="group" aria-label="@Calendar.TimeText">
                <span class="mui-date-picker-time-label">@Calendar.TimeText</span>

                <div class="mui-date-picker-time-content">
                    <label class="mui-date-picker-time-field">
                        <input type="number"
                               class="@Calendar.TimeInputClassNames"
                               min="@(Parent.TimeAs24hr ? 0 : 1)"
                               max="@(Parent.TimeAs24hr ? 23 : 12)"
                               value="@Calendar.DisplayHourText"
                               aria-label="@Calendar.HourText"
                               tabindex="0"
                               disabled="@Parent.CalendarInteractionDisabled"
                               @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                               @onkeydown:stopPropagation
                               @onchange="@Parent.ChangeHourAsync" />
                        <span>@Calendar.HourText</span>
                    </label>

                    <span class="mui-date-picker-time-separator" aria-hidden="true">:</span>

                    <label class="mui-date-picker-time-field">
                        <input type="number"
                               class="@Calendar.TimeInputClassNames"
                               min="0"
                               max="59"
                               value="@Calendar.CurrentMinuteText"
                               aria-label="@Calendar.MinuteText"
                               tabindex="0"
                               disabled="@Parent.CalendarInteractionDisabled"
                               @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                               @onkeydown:stopPropagation
                               @onchange="@Parent.ChangeMinuteAsync" />
                        <span>@Calendar.MinuteText</span>
                    </label>

                    @if ( !Parent.TimeAs24hr )
                    {
                        <div class="mui-date-picker-period" role="group" aria-label="@($"{Calendar.AnteMeridiemText}/{Calendar.PostMeridiemText}")">
                            <button type="button"
                                    class="@GetPeriodClass( false )"
                                    aria-pressed="@(!Calendar.IsPostMeridiem)"
                                    tabindex="0"
                                    disabled="@Parent.CalendarInteractionDisabled"
                                    @onmousedown:preventDefault
                                    @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                                    @onkeydown:stopPropagation
                                    @onclick="@(() => SetMeridiemAsync( false ))">
                                @Calendar.AnteMeridiemText
                            </button>
                            <button type="button"
                                    class="@GetPeriodClass( true )"
                                    aria-pressed="@Calendar.IsPostMeridiem"
                                    tabindex="0"
                                    disabled="@Parent.CalendarInteractionDisabled"
                                    @onmousedown:preventDefault
                                    @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                                    @onkeydown:stopPropagation
                                    @onclick="@(() => SetMeridiemAsync( true ))">
                                @Calendar.PostMeridiemText
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        @if ( Parent.ShowTodayButton || Parent.ShowClearButton )
        {
            <div class="@Calendar.ActionsClassNames">
                @if ( Parent.ShowClearButton )
                {
                    <button type="button"
                            class="@Calendar.ButtonClassNames"
                            tabindex="0"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onmousedown:preventDefault
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onclick="@Parent.ClearAsync">
                        @Calendar.ClearText
                    </button>
                }
                @if ( Parent.ShowTodayButton )
                {
                    <button type="button"
                            class="@Calendar.ButtonClassNames"
                            tabindex="0"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onmousedown:preventDefault
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onclick="@Parent.SelectTodayAsync">
                        @Calendar.TodayText
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private bool focusApplied;

    private bool gridFocused;

    private ElementReference CalendarElementRef;

    private void HandleGridFocus( FocusEventArgs eventArgs )
        => gridFocused = true;

    private void HandleGridBlur( FocusEventArgs eventArgs )
        => gridFocused = false;

    private string GetDayClassNames( DatePickerCalendarDay day )
        => $"{Calendar.GetDayClassNames( day )}{( gridFocused && day.Focused && !Parent.FocusCalendarOnOpen ? " mui-date-picker-day-focused" : null )}";

    private string GetMonthClassNames( DatePickerCalendarMonth month )
        => $"{Calendar.GetMonthClassNames( month )}{( gridFocused && month.Focused && !Parent.FocusCalendarOnOpen ? " mui-date-picker-month-focused" : null )}";

    private string GetPeriodClass( bool postMeridiem )
        => $"mui-date-picker-period-button{( Calendar.IsPostMeridiem == postMeridiem ? " mui-date-picker-period-button-selected" : null )}";

    private Task SetMeridiemAsync( bool postMeridiem )
        => Calendar.IsPostMeridiem == postMeridiem
            ? Task.CompletedTask
            : Parent.ToggleMeridiemAsync();

    protected override async Task OnAfterRenderAsync( bool firstRender )
    {
        if ( Parent.CalendarVisible && !Parent.Inline )
        {
            if ( Parent.FocusCalendarOnOpen && !focusApplied )
            {
                focusApplied = true;
                await CalendarElementRef.FocusAsync( preventScroll: true );
            }
            else if ( !Parent.FocusCalendarOnOpen )
            {
                focusApplied = false;
            }
        }
        else
        {
            focusApplied = false;
        }
    }
}