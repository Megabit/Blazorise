@inherits Blazorise.Step
<CascadingValue Value="@this" IsFixed>
    <li @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tab" tabindex="@TabIndex" aria-labelledby="@AriaLabelledBy" aria-controls="@AriaControls" aria-selected="@AriaSelectedString" @onclick="@OnClickHandler" @attributes="@Attributes">
        <span class="tw-step-connector pointer-events-none absolute end-32 top-5 grid h-1 w-full -translate-y-1/2 grid-cols-[0_100%] grid-rows-[100%] justify-end [column-gap:inherit] before:col-[1/-1] before:row-[1/-1] before:ms-18 before:rounded-full before:bg-gray-200 before:content-[''] dark:before:bg-gray-700" aria-hidden="true"></span>
        <div class="@ContainerClassNames" style="@ContainerStyleNames">
            <span class="@MarkerClassNames" style="@Styles?.Marker">
                @if ( Marker is not null )
                {
                    @Marker
                }
                else if ( Completed )
                {
                    <svg class="h-5 w-5" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none">
                        <path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="sr-only">@CalculatedIndex</span>
                }
                else
                {
                    @CalculatedIndex
                }
            </span>
            @if ( Caption is not null || ChildContent is not null )
            {
                <span class="@DescriptionClassNames" style="@Styles?.Description">
                    @if ( Caption is not null )
                    {
                        @Caption
                    }
                    else
                    {
                        @ChildContent
                    }
                </span>
            }
        </div>
    </li>
</CascadingValue>