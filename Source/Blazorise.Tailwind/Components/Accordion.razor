@inherits Blazorise.Accordion
<CascadingValue Value="@this" IsFixed>
    <div @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" data-accordion="collapse" data-animation-duration="@AnimationDurationString" @attributes="@Attributes">
        @ChildContent
    </div>
</CascadingValue>