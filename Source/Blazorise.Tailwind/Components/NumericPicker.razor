@namespace Blazorise.Tailwind.Components
@typeparam TValue
@inherits Blazorise.NumericPicker<TValue>
<Div Class="@NumericWrapperClassNames" Style="@NumericWrapperStyleNames">
    <input @ref="@ElementRef" id="@ElementId" name="@NameAttributeValue" inputmode="@InputMode" class="@ClassNames" style="@StyleNames" placeholder="@Placeholder" disabled="@IsDisabled" readonly="@ReadOnly" size="@VisibleCharacters" step="@StepString" pattern="@Pattern" tabindex="@TabIndex" aria-invalid="@ResolvedAriaInvalid" aria-required="@ResolvedAriaRequired" aria-describedby="@ResolvedAriaDescribedBy" aria-labelledby="@ExplicitAriaLabelledBy" @onkeydown="@OnKeyDownHandler" @onkeypress="@OnKeyPressHandler" @onkeyup="@OnKeyUpHandler" @onblur="@OnBlurHandler" @onfocus="@OnFocusHandler" @onfocusin="@OnFocusInHandler" @onfocusout="@OnFocusOutHandler" @attributes="@Attributes" />
    @if ( IsShowStepButtons )
    {
        <Div Class="@ButtonsClassNames" Style="@Styles?.Buttons">
            <button tabindex="-1" aria-label="Increment value" type="button" class="@ButtonUpClassNames" style="@Styles?.ButtonUp" disabled="@( IsDisabled || ReadOnly )" @onclick="@OnSpinUpClicked">
                <Icon Name="IconName.ChevronUp" />
            </button>
            <button tabindex="-1" aria-label="Decrement value" type="button" class="@ButtonDownClassNames" style="@Styles?.ButtonDown" disabled="@( IsDisabled || ReadOnly )" @onclick="@OnSpinDownClicked">
                <Icon Name="IconName.ChevronDown" />
            </button>
        </Div>
    }
</Div>
@ChildContent
@Feedback