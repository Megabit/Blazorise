@namespace Blazorise
@inherits BaseComponent<StepsClasses, StepsStyles>
<CascadingValue Value="@this" IsFixed>
    <CascadingValue Value="@State">
        @if ( StepPosition == StepPosition.Start && Items is not null && Content is not null )
        {
            <Row>
                <Column ColumnSize="ColumnSize.IsAuto">
                    <ul @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tablist" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-orientation="@AriaOrientationString" @attributes="@Attributes">
                        @Items
                    </ul>
                </Column>
                <Column>
                    <div class="@ContentClassNames" style="@Styles?.Content" @attributes="@Attributes">
                        @Content
                    </div>
                </Column>
            </Row>
        }
        else if ( StepPosition == StepPosition.End && Items is not null && Content is not null )
        {
            <Row>
                <Column>
                    <div class="@ContentClassNames" style="@Styles?.Content" @attributes="@Attributes">
                        @Content
                    </div>
                </Column>
                <Column ColumnSize="ColumnSize.IsAuto">
                    <ul @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tablist" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-orientation="@AriaOrientationString" @attributes="@Attributes">
                        @Items
                    </ul>
                </Column>
            </Row>
        }
        else if ( StepPosition == StepPosition.Bottom && Items is not null && Content is not null )
        {
            <div class="@ContentClassNames" style="@Styles?.Content" @attributes="@Attributes">
                @Content
            </div>
            <ul @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tablist" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-orientation="@AriaOrientationString" @attributes="@Attributes">
                @Items
            </ul>
        }
        else if ( Items is not null && Content is not null )
        {
            <ul @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tablist" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-orientation="@AriaOrientationString" @attributes="@Attributes">
                @Items
            </ul>
            <div class="@ContentClassNames" style="@Styles?.Content" @attributes="@Attributes">
                @Content
            </div>
        }
        else
        {
            <ul @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tablist" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-orientation="@AriaOrientationString" @attributes="@Attributes">
                @( Items ?? ChildContent )
            </ul>
        }
    </CascadingValue>
</CascadingValue>