@namespace Blazorise
@inherits BaseComponent

<Button ElementId="@ElementId"
        Class="@ClassNames"
        Style="@StyleNames"
        Size="@Size"
        Color="@Color"
        Outline="@Outline"
        Active="@Active"
        Disabled="@Disabled"
        Clicked="@OnClicked"
        title="@Title"
        aria-label="@Title"
        aria-pressed="@Active"
        @attributes="@Attributes">
    @if ( ChildContent is not null )
    {
        @ChildContent
    }
    else
    {
        @if ( Icon is not null )
        {
            <Icon Name="@Icon" />
        }
        @if ( ShowText )
        {
            <Span>@Text</Span>
        }
    }
</Button>