@namespace Blazorise
@inherits BasePropertyGridEditorItem

<PropertyGridItem Label="@Label"
                  LabelContent="@LabelContent"
                  Selectable="@Selectable"
                  Selected="@Selected"
                  SelectedChanged="@SelectedChanged"
                  AriaDescribedBy="@AriaDescribedBy"
                  ElementId="@ElementId"
                  Size="@Size"
                  Class="@ClassNames"
                  Style="@StyleNames"
                  ActionContent="@ActionContent"
                  data-property-grid-editor="text"
                  @attributes="@Attributes">
    @if ( Multiline )
    {
        <MemoInput Value="@DisplayValue"
                   ValueChanged="@ValueChanged"
                   ReadOnly="@ReadOnly"
                   Immediate="@EffectiveImmediate"
                   Debounce="true"
                   Rows="3"
                   Size="@Size" />
    }
    else
    {
        <TextInput Value="@DisplayValue"
                   ValueChanged="@ValueChanged"
                   ReadOnly="@ReadOnly"
                   Immediate="@EffectiveImmediate"
                   Debounce="true"
                   Size="@Size" />
    }
</PropertyGridItem>