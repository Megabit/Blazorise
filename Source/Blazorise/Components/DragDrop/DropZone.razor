@namespace Blazorise
@typeparam TItem
@inherits BaseComponent<DropZoneClasses, DropZoneStyles>
<CascadingValue Value="@this" IsFixed>
    <div @key="@ElementId" @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" data-transaction-active="@TransactionActiveString" data-transaction-current="@TransactionCurrentString" @ondragenter="@OnDragEnterHandler" @ondragleave="@OnDragLeaveHandler" @ondrop="@OnDropHandler" @attributes="@Attributes">
        @ChildContent

        @if ( !OnlyZone )
        {
            var index = 0;
            var transactionIndex = ParentContainer?.GetTransactionIndex() ?? -1;
            var items = GetItems();

            @if ( AllowReorder )
            {
                @DraggablePreviewFragment(transactionIndex)
            }

            @foreach ( var item in items )
            {
                <_Draggable @key="@((ElementId, item))" TItem="TItem" Item="@item" ZoneName="@Name" DraggingClass="@GetItemDraggingClass()" Disabled="@GetItemDisabled(item)" DisabledClass="@GetItemDisabledClass()" DragStarted="@OnDragStarted" DragEnded="@OnDragEnded" Index="@index">
                    @{
                        var renderer = ItemTemplate ?? ParentContainer?.ItemTemplate;
                    }

                    @if ( renderer is not null )
                    {
                        @renderer(item)
                    }
                </_Draggable>

                if ( CanReorder && transactionIndex == index )
                {
                    <div @key="@($"{ElementId}_item_placeholder")" class="@PlaceholderClassBuilder.Class" style="@Styles?.Placeholder" data-reorder-placeholder="@ReorderPlaceholderString" data-placeholder-visible="@PlaceholderVisibleString" inert="@(!EffectiveShowPlaceholder)">@PlaceholderContentFragment</div>
                }

                index++;
            }
        }
    </div>
</CascadingValue>
@code {
    protected RenderFragment<int> DraggablePreviewFragment => transactionIndex => __builder =>
    {
        if ( !items.Any() )
        {
            <div @key="@($"{ElementId}_item_preview_placeholder")" class="@PlaceholderClassBuilder.Class" style="@Styles?.Placeholder" data-reorder-placeholder="@ReorderPlaceholderString" data-placeholder-visible="@PlaceholderVisibleString" inert="@(!EffectiveShowPlaceholder)">@PlaceholderContentFragment</div>
        }
        else
        {
            if ( transactionIndex == -1 )
            {
                <div @key="@($"{ElementId}_item_preview_placeholder")" class="@PlaceholderClassBuilder.Class" style="@Styles?.Placeholder" data-reorder-placeholder="@ReorderPlaceholderString" data-placeholder-visible="@PlaceholderVisibleString" inert="@(!EffectiveShowPlaceholder)">@PlaceholderContentFragment</div>
            }

            <_Draggable @key="@($"{ElementId}_item_preview")" TItem="TItem" Item="default" ZoneName="@Name" Disabled="true" HideContent="false" Class="draggable-preview-start" />
        }
    };

    protected RenderFragment PlaceholderContentFragment => @<text>
        @if ( EffectivePlaceholderTemplate is not null
            && ParentContainer?.TransactionInProgress == true
            && ParentContainer.TransactionCurrentZoneName == Name )
        {
            @EffectivePlaceholderTemplate( ParentContainer.GetTransactionItem() )
        }
    </text>;
}