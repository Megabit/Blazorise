@namespace Blazorise
@typeparam TValue
@inherits BaseTextInput<TValue, TimePickerClasses, TimePickerStyles>
<div id="@PickerContainerId" class="@PickerContainerClassNames" style="@PickerContainerStyleNames">
    <input @ref="@ElementRef"
           id="@ElementId"
           type="text"
           name="@NameAttributeValue"
           class="@ClassNames"
           style="@StyleNames"
           disabled="@IsDisabled"
           readonly="@ReadOnly"
           pattern="@Pattern"
           value="@InputText"
           @oninput="@OnInputHandler"
           @onchange="@OnChangeHandler"
           @onclick="@OnClickHandler"
           @onkeydown="@OnKeyDownHandler"
           @onkeypress="@OnKeyPressHandler"
           @onkeyup="@OnKeyUpHandler"
           @onblur="@OnBlurHandler"
           @onfocus="@OnFocusHandler"
           @onfocusin="@OnFocusInHandler"
           @onfocusout="@OnFocusOutHandler"
           placeholder="@Placeholder"
           tabindex="@TabIndex"
           role="combobox"
           aria-haspopup="dialog"
           aria-expanded="@MenuVisible"
           aria-controls="@MenuId"
           aria-invalid="@ResolvedAriaInvalid"
           aria-required="@ResolvedAriaRequired"
           aria-describedby="@ResolvedAriaDescribedBy"
           aria-labelledby="@ExplicitAriaLabelledBy"
           autocomplete="off"
           @attributes="@Attributes" />
    <_TimePickerMenu TValue="TValue" Parent="@this" />
</div>
@ChildContent
@Feedback