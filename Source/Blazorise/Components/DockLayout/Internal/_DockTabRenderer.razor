@namespace Blazorise
@inherits BaseComponent
<span class="@ClassNames" data-dock-tab-name="@PaneName" @onpointerdown="@BeginPaneTabDrag" @onclick="@ActivateTab">
    <button id="@ElementId" type="button" class="@LabelClassNames" role="tab" aria-selected="@( Active.ToString().ToLowerInvariant() )" aria-controls="@Context.GetDockNodeElementId( NodeId )" data-dock-tab-label="true">@Caption</button>
    @if ( CloseButtonVisible )
    {
        <button type="button" class="@CloseClassNames" title="Close" aria-label="Close @Caption" @onclick="@ClosePane" @onclick:stopPropagation @onpointerdown:stopPropagation>
            <Icon Name="IconName.Times" />
        </button>
    }
</span>