@namespace Blazorise
@inherits BaseComponent
@if ( Visible )
{
    <span class="@ClassNames" @onpointerdown:stopPropagation>
        @if ( AutoHideActionVisible )
        {
            <button type="button" class="@ActionClassNames" title="@AutoHideTitle" aria-label="@AutoHideTitle" @onclick="@ToggleAutoHide">
                <Icon Name="@AutoHideIconName" />
            </button>
        }
        @if ( CloseActionVisible )
        {
            <button type="button" class="@ActionClassNames" title="@Localizer["Close"]" aria-label="@Localizer["Close"]" @onclick="@Close">
                <Icon Name="IconName.Times" />
            </button>
        }
    </span>
}