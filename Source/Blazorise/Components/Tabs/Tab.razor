@namespace Blazorise
@inherits BaseComponent<TabClasses, TabStyles>
<li @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" @attributes="@Attributes">
    <a id="@TabElementId" class="@LinkClassNames" style="@Styles?.Link" role="tab" tabindex="@TabIndex" aria-labelledby="@AriaLabelledBy" aria-controls="@AriaControls" aria-selected="@AriaSelectedString" aria-disabled="@AriaDisabledString" @onclick="@ClickHandler">@ChildContent</a>
</li>