@namespace Blazorise
@inherits BaseComponent<TabClasses, TabStyles>
<li @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" @attributes="@Attributes">
    <a id="@TabElementId" class="@LinkClassNames" style="@Styles?.Link" @onclick="@ClickHandler" tabindex="@TabIndex" role="tab" aria-labelledby="@AriaLabelledBy" aria-controls="@AriaControls" aria-selected="@AriaSelectedString" aria-disabled="@AriaDisabledString">@ChildContent</a>
</li>