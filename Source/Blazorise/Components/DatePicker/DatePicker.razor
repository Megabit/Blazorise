@namespace Blazorise
@typeparam TValue
@inherits BaseTextInput<TValue, DatePickerClasses, DatePickerStyles>
<div id="@PickerContainerId" class="@PickerContainerClassNames" style="@PickerContainerStyleNames">
    <input @ref="@ElementRef"
           id="@ElementId"
           type="@InputType"
           name="@NameAttributeValue"
           class="@ClassNames"
           style="@StyleNames"
           disabled="@IsDisabled"
           readonly="@ReadOnly"
           pattern="@Pattern"
           value="@VisibleInputText"
           @onchange="@OnChangeHandler"
           @onclick="@NonRenderingClickHandler"
           @onkeydown="@NonRenderingKeyDownHandler"
           @onkeypress="@NonRenderingKeyPressHandler"
           @onkeyup="@NonRenderingKeyUpHandler"
           @onblur="@NonRenderingBlurHandler"
           @onfocus="@NonRenderingFocusHandler"
           @onfocusin="@NonRenderingFocusInHandler"
           @onfocusout="@NonRenderingFocusOutHandler"
           placeholder="@Placeholder"
           min="@InputMin"
           max="@InputMax"
           step="@InputStep"
           tabindex="@TabIndex"
           role="@InputRole"
           aria-haspopup="@InputAriaHasPopup"
           aria-expanded="@InputAriaExpanded"
           aria-controls="@InputAriaControls"
           aria-invalid="@ResolvedAriaInvalid"
           aria-required="@ResolvedAriaRequired"
           aria-describedby="@ResolvedAriaDescribedBy"
           aria-labelledby="@ExplicitAriaLabelledBy"
           data-open-keys="@(InputKeyboardNavigationEnabled ? "true" : null)"
           autocomplete="off"
           @attributes="@Attributes" />
    <_DatePickerCalendar TValue="TValue" Parent="@this" />
</div>
@ChildContent
@Feedback