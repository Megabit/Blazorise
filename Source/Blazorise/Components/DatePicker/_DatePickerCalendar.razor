@namespace Blazorise
@typeparam TValue
@using System
@using Microsoft.AspNetCore.Components.Web

@if ( Parent.CalendarVisible )
{
    @if ( !Parent.Inline )
    {
        <div class="@Parent.CalendarBackdropClassNames"
             aria-hidden="true"></div>
    }

    <div @ref="@CalendarElementRef"
         id="@Parent.CalendarId"
         class="@Parent.CalendarClassNames"
         role="dialog"
         aria-modal="false"
         aria-labelledby="@($"{Parent.CalendarId}-title")"
         aria-activedescendant="@(Parent.InputMode == DateInputMode.Month ? Parent.GetMonthId( Parent.FocusedDate ) : Parent.GetDayId( Parent.FocusedDate ))"
         tabindex="-1"
         @onkeydown="@Parent.OnCalendarKeyDownAsync"
         @onkeydown:stopPropagation>
        <div class="@Parent.CalendarHeaderClassNames">
            <button type="button"
                    class="@Parent.CalendarNavigationClassNames"
                    aria-label="@Parent.PreviousPeriodAriaLabel"
                    tabindex="@Parent.CalendarControlTabIndex"
                    disabled="@Parent.CalendarInteractionDisabled"
                    @onmousedown:preventDefault
                    @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                    @onkeydown:stopPropagation
                    @onclick="@Parent.ShowPreviousPeriod">
                <span aria-hidden="true">@Parent.PreviousText</span>
            </button>

            <div id="@($"{Parent.CalendarId}-title")" class="@Parent.CalendarTitleClassNames" aria-live="polite">
                @if ( Parent.InputMode == DateInputMode.Month )
                {
                    <input type="number"
                           min="1"
                           max="9999"
                           value="@Parent.VisibleMonthYear"
                           aria-label="@Parent.YearText"
                           tabindex="@Parent.CalendarControlTabIndex"
                           disabled="@Parent.CalendarInteractionDisabled"
                           @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                           @onkeydown:stopPropagation
                           @onchange="@Parent.ChangeVisibleYear" />
                }
                else
                {
                    <select value="@Parent.VisibleMonthNumber"
                            aria-label="@Parent.MonthText"
                            tabindex="@Parent.CalendarControlTabIndex"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onchange="@Parent.ChangeVisibleMonth">
                        @for ( int monthIndex = 0; monthIndex < Parent.MonthNames.Length; monthIndex++ )
                        {
                            <option value="@(monthIndex + 1)">@Parent.MonthNames[monthIndex]</option>
                        }
                    </select>
                    <input type="number"
                           min="1"
                           max="9999"
                           value="@Parent.VisibleMonthYear"
                           aria-label="@Parent.YearText"
                           tabindex="@Parent.CalendarControlTabIndex"
                           disabled="@Parent.CalendarInteractionDisabled"
                           @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                           @onkeydown:stopPropagation
                           @onchange="@Parent.ChangeVisibleYear" />
                }
            </div>

            <button type="button"
                    class="@Parent.CalendarNavigationClassNames"
                    aria-label="@Parent.NextPeriodAriaLabel"
                    tabindex="@Parent.CalendarControlTabIndex"
                    disabled="@Parent.CalendarInteractionDisabled"
                    @onmousedown:preventDefault
                    @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                    @onkeydown:stopPropagation
                    @onclick="@Parent.ShowNextPeriod">
                <span aria-hidden="true">@Parent.NextText</span>
            </button>
        </div>

        @if ( Parent.InputMode == DateInputMode.Month )
        {
            <div class="@Parent.CalendarMonthsClassNames" role="grid" aria-label="@Parent.CalendarLabel">
                @foreach ( DatePickerCalendarMonth month in Parent.BuildCalendarMonths() )
                {
                    <button id="@Parent.GetMonthId( month.Date )"
                            @key="@month.Date"
                            type="button"
                            role="gridcell"
                            class="@Parent.GetCalendarMonthClassNames( month )"
                            aria-label="@($"{month.Name} {month.Date.Year}")"
                            aria-selected="@month.Selected"
                            disabled="@month.Disabled"
                            tabindex="-1"
                            @onmousedown:preventDefault
                            @onclick="@(() => Parent.SelectMonthAsync( month.Date ))">
                        @month.Name
                    </button>
                }
            </div>
        }
        else
        {
            <div class="@Parent.CalendarGridClassNames"
                 role="grid"
                 aria-label="@Parent.CalendarLabel">
                <div class="@Parent.CalendarWeekdaysClassNames" role="row">
                    @if ( Parent.ShowWeekNumbers )
                    {
                        <span class="@Parent.CalendarWeekNumberClassNames" role="columnheader">@Parent.WeekText</span>
                    }
                    @foreach ( string weekday in Parent.WeekdayNames )
                    {
                        <span class="@Parent.CalendarWeekdayClassNames" role="columnheader">@weekday</span>
                    }
                </div>

                @foreach ( DatePickerCalendarWeek week in Parent.BuildCalendarWeeks() )
                {
                    <div class="@Parent.CalendarWeekClassNames" role="row">
                        @if ( Parent.ShowWeekNumbers )
                        {
                            <span class="@Parent.CalendarWeekNumberClassNames" role="rowheader">@week.WeekNumber</span>
                        }
                        @foreach ( DatePickerCalendarDay day in week.Days )
                        {
                            <button id="@Parent.GetDayId( day.Date )"
                                    @key="@day.Date"
                                    type="button"
                                    role="gridcell"
                                    class="@Parent.GetCalendarDayClassNames( day )"
                                    aria-label="@Parent.GetDateAriaLabel( day.Date )"
                                    aria-selected="@day.Selected"
                                    aria-current="@(day.Today ? "date" : null)"
                                    disabled="@day.Disabled"
                                    tabindex="-1"
                                    @onmousedown:preventDefault
                                    @onmouseover="@(() => Parent.PreviewRange( day.Date ))"
                                    @onmouseout="@(() => Parent.PreviewRange( null ))"
                                    @onclick="@(() => Parent.SelectDateAsync( day.Date ))">
                                @day.Date.Day
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @if ( Parent.InputMode == DateInputMode.DateTime )
        {
            <div class="@Parent.CalendarTimeClassNames" role="group" aria-label="@Parent.TimeText">
                <input type="number"
                       class="@Parent.CalendarTimeInputClassNames"
                       min="@(Parent.TimeAs24hr ? 0 : 1)"
                       max="@(Parent.TimeAs24hr ? 23 : 12)"
                       value="@Parent.DisplayHourText"
                       aria-label="@Parent.HourText"
                       tabindex="@Parent.CalendarControlTabIndex"
                       disabled="@Parent.CalendarInteractionDisabled"
                       @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                       @onkeydown:stopPropagation
                       @onchange="@Parent.ChangeHourAsync" />
                <span aria-hidden="true">:</span>
                <input type="number"
                       class="@Parent.CalendarTimeInputClassNames"
                       min="0"
                       max="59"
                       value="@Parent.CurrentMinuteText"
                       aria-label="@Parent.MinuteText"
                       tabindex="@Parent.CalendarControlTabIndex"
                       disabled="@Parent.CalendarInteractionDisabled"
                       @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                       @onkeydown:stopPropagation
                       @onchange="@Parent.ChangeMinuteAsync" />
                @if ( !Parent.TimeAs24hr )
                {
                    <button type="button"
                            class="@Parent.CalendarButtonClassNames"
                            aria-label="@Parent.MeridiemText"
                            tabindex="@Parent.CalendarControlTabIndex"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onmousedown:preventDefault
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onclick="@Parent.ToggleMeridiemAsync">
                        @Parent.MeridiemText
                    </button>
                }
            </div>
        }

        @if ( Parent.ShowTodayButton || Parent.ShowClearButton )
        {
            <div class="@Parent.CalendarActionsClassNames">
                @if ( Parent.ShowClearButton )
                {
                    <button type="button"
                            class="@Parent.CalendarButtonClassNames"
                            tabindex="@Parent.CalendarControlTabIndex"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onmousedown:preventDefault
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onclick="@Parent.ClearAsync">
                        @Parent.ClearText
                    </button>
                }
                @if ( Parent.ShowTodayButton )
                {
                    <button type="button"
                            class="@Parent.CalendarButtonClassNames"
                            tabindex="@Parent.CalendarControlTabIndex"
                            disabled="@Parent.CalendarInteractionDisabled"
                            @onmousedown:preventDefault
                            @onkeydown="@Parent.OnCalendarControlKeyDownAsync"
                            @onkeydown:stopPropagation
                            @onclick="@Parent.SelectTodayAsync">
                        @Parent.TodayText
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private bool focusApplied;

    private ElementReference CalendarElementRef;

    [Parameter]
    public DatePicker<TValue> Parent { get; set; }

    protected override async Task OnAfterRenderAsync( bool firstRender )
    {
        if ( Parent.CalendarVisible && !Parent.Inline )
        {
            if ( Parent.FocusCalendarOnOpen && !focusApplied )
            {
                focusApplied = true;
                await CalendarElementRef.FocusAsync( preventScroll: true );
            }
            else if ( !Parent.FocusCalendarOnOpen )
            {
                focusApplied = false;
            }
        }
        else
        {
            focusApplied = false;
        }
    }
}