@namespace Blazorise.Reporting.DataSources.Csv
@inherits Blazorise.Reporting.Internal.BaseReportComponent
@using Blazorise
@using static Blazorise.Reporting.DataSources.Csv.FluentConstants

<Div Flex="Flex.Column" Gap="Gap.Is2">
    <Paragraph TextColor="TextColor.Secondary" TextSize="TextSize.Small" Margin="Margin.Is0">
        Choose a local CSV file, paste CSV text, or enter an HTTP/HTTPS URL. File paths are supported outside browser-hosted applications.
    </Paragraph>

    <Field Horizontal>
        <FieldLabel ColumnSize="ColumnSizeIs3" TextSize="TextSize.Small">CSV file</FieldLabel>
        <FieldBody ColumnSize="ColumnSizeIs9">
            <FileInput Changed="@OnFileChanged"
                       Filter=".csv,text/csv,text/plain"
                       MaxFileSize="@MaxCsvFileSize"
                       Placeholder="Choose CSV file"
                       Disabled="@(Context?.Disabled == true)"
                       Size="Size.Small"
                       DisableProgressReport />
        </FieldBody>
    </Field>

    @if ( !string.IsNullOrWhiteSpace( fileError ) )
    {
        <Alert Color="Color.Danger" Visible>
            @fileError
        </Alert>
    }

    <Field Horizontal>
        <FieldLabel ColumnSize="ColumnSizeIs3" TextSize="TextSize.Small">Source</FieldLabel>
        <FieldBody ColumnSize="ColumnSizeIs9">
            <MemoInput Value="@Source" ValueChanged="@OnSourceChanged" Placeholder="CSV text, file path, or URL" Disabled="@(Context?.Disabled == true)" Size="Size.Small" Rows="5" />
        </FieldBody>
    </Field>

    <Field Horizontal>
        <FieldLabel ColumnSize="ColumnSizeIs3" TextSize="TextSize.Small">Encoding</FieldLabel>
        <FieldBody ColumnSize="ColumnSizeIs9">
            <Select TValue="string" Value="@SelectedEncoding" ValueChanged="@OnEncodingChanged" Disabled="@(Context?.Disabled == true)" Size="Size.Small">
                @foreach ( CsvReportDataSourceEditorOption option in EncodingOptions )
                {
                    <SelectItem TValue="string" Value="@option.Value">@option.Text</SelectItem>
                }
            </Select>
        </FieldBody>
    </Field>

    <Field Horizontal>
        <FieldLabel ColumnSize="ColumnSizeIs3" TextSize="TextSize.Small">Separator</FieldLabel>
        <FieldBody ColumnSize="ColumnSizeIs9">
            <Div Flex="Flex.Row" Gap="Gap.Is2">
                <Select TValue="string" Value="@SelectedDelimiter" ValueChanged="@OnDelimiterChanged" Disabled="@(Context?.Disabled == true)" Size="Size.Small">
                    @foreach ( CsvReportDataSourceEditorOption option in DelimiterOptions )
                    {
                        <SelectItem TValue="string" Value="@option.Value">@option.Text</SelectItem>
                    }
                </Select>
                @if ( IsCustomDelimiter )
                {
                    <TextInput Value="@CustomDelimiter" ValueChanged="@OnCustomDelimiterChanged" Disabled="@(Context?.Disabled == true)" Size="Size.Small" />
                }
            </Div>
        </FieldBody>
    </Field>

    <Field Horizontal>
        <FieldLabel ColumnSize="ColumnSizeIs3" TextSize="TextSize.Small">Header row</FieldLabel>
        <FieldBody ColumnSize="ColumnSizeIs9">
            <Check TValue="bool" Value="@HasHeaderRow" ValueChanged="@OnHasHeaderRowChanged" Disabled="@(Context?.Disabled == true)">First row contains field names</Check>
        </FieldBody>
    </Field>
</Div>