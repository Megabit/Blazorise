@namespace Blazorise.Reporting.Internal
@inherits BaseReportComponent

<DockSplit Orientation="Orientation.Horizontal" Ratio="0.24">
    <DockSplit Orientation="Orientation.Vertical" Ratio="0.34">
        <DockPane Name="@ToolboxPaneName"
                  Caption="@Localize( "Toolbox" )"
                  Role="DockPaneRole.Tool"
                  PanePosition="DockPanePosition.Left"
                  Size="18rem"
                  MinSize="12rem"
                  Resizable
                  TabPosition="DockPaneTabPosition.Bottom">
            <DockPaneHeader>
                @Localize( "Toolbox" )
            </DockPaneHeader>
            <DockPaneBody Class="b-report-designer-toolbox-pane"
                          @ref="@toolboxPaneBody"
                          Padding="PaddingIs3">
                @ToolboxPanel
            </DockPaneBody>
        </DockPane>

        <DockPane Name="@FieldsExplorerPaneName"
                  @ref="@fieldsExplorerPane"
                  Caption="@Localize( "Fields Explorer" )"
                  Role="DockPaneRole.Tool"
                  PanePosition="DockPanePosition.Left"
                  Size="18rem"
                  MinSize="12rem"
                  Resizable
                  TabPosition="DockPaneTabPosition.Bottom">
            <DockPaneHeader>
                @Localize( "Fields Explorer" )
            </DockPaneHeader>
            <DockPaneBody Class="b-report-designer-fields-explorer-pane"
                          @ref="@fieldsExplorerPaneBody"
                          Padding="PaddingIs3">
                @FieldsExplorerPanel
            </DockPaneBody>
        </DockPane>
    </DockSplit>

    <DockSplit Orientation="Orientation.Horizontal" Ratio="0.76">
        <DockPane Name="@SurfacePaneName"
                  @ref="@surfacePane"
                  Caption="@Localize( "Report Designer" )"
                  Role="DockPaneRole.Document"
                  PanePosition="DockPanePosition.Center"
                  ShowTab="false"
                  Closable="false">
            <DockPaneBody Class="b-report-designer-surface"
                          Padding="PaddingIs0"
                          Flex="FlexColumn"
                          Overflow="OverflowHidden">
                @PageTabs
                <Div Class="b-report-designer-surface-content"
                     @ref="@surfacePaneScrollBody"
                     Flex="FlexGrowIs1"
                     Overflow="OverflowAuto">
                    @Surface
                </Div>
            </DockPaneBody>
        </DockPane>

        <DockTabs ActivePane="@ActivePanelPaneName">
            <DockPane Name="@PropertiesPaneName"
                      @ref="@propertiesPane"
                      Caption="@Localize( "Properties" )"
                      Role="DockPaneRole.Tool"
                      PanePosition="DockPanePosition.Right"
                      Size="20rem"
                      MinSize="14rem"
                      Resizable
                      TabPosition="DockPaneTabPosition.Bottom">
                <DockPaneHeader>
                    @Localize( "Properties" )
                </DockPaneHeader>
                <DockPaneBody @ref="@propertiesPaneBody"
                              Padding="PaddingIs3"
                              Overflow="OverflowHidden">
                    @PropertiesPanel
                </DockPaneBody>
            </DockPane>

            <DockPane Name="@ReportExplorerPaneName"
                      @ref="@reportExplorerPane"
                      Caption="@Localize( "Report Explorer" )"
                      Role="DockPaneRole.Tool"
                      PanePosition="DockPanePosition.Right"
                      Size="20rem"
                      MinSize="14rem"
                      Resizable
                      TabPosition="DockPaneTabPosition.Bottom">
                <DockPaneHeader>
                    @Localize( "Report Explorer" )
                </DockPaneHeader>
                <DockPaneBody Class="b-report-designer-report-explorer-pane"
                              @ref="@reportExplorerPaneBody"
                              Padding="PaddingIs0">
                    @ReportExplorerPanel
                </DockPaneBody>
            </DockPane>
        </DockTabs>
    </DockSplit>
</DockSplit>