@namespace Blazorise.Reporting.Internal
@inherits BaseReportComponent

<Div Flex="FlexColumn" Gap="GapIs2">
    <Paragraph TextColor="TextColorSecondary" TextSize="TextSizeSmall" Margin="MarginIs0">
        @Localize( "DataSet data sources use a DataSet or DataTable supplied by the report data object or by a declarative data source component." )
    </Paragraph>
    <TextInput Value="@TableName" ValueChanged="@OnTableNameChanged" Placeholder="@Localize( "Optional table name" )" Disabled="@(Context?.Disabled == true)" Size="Size.Small" />
</Div>