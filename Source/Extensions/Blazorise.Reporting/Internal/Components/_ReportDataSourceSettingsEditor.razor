@namespace Blazorise.Reporting.Internal
@inherits BaseReportComponent
@using Microsoft.AspNetCore.Components.Web

<Div Flex="FlexColumn" Gap="GapIs2">
    @if ( settings.Count == 0 )
    {
        <Paragraph TextColor="TextColorSecondary" TextSize="TextSizeSmall" Margin="MarginIs0">@Localize( "No provider settings defined." )</Paragraph>
    }
    @foreach ( ReportDataSourceSettingItem setting in settings )
    {
        <Div @key="setting.Id" Flex="FlexRow" Gap="GapIs2">
            <TextInput Value="@setting.Key" ValueChanged="@(( string value ) => OnSettingKeyChanged( setting, value ))" Placeholder="@Localize( "Key" )" Disabled="@(Context?.Disabled == true)" Size="Size.Small" />
            <TextInput Value="@setting.Value" ValueChanged="@(( string value ) => OnSettingValueChanged( setting, value ))" Placeholder="@Localize( "Value" )" Disabled="@(Context?.Disabled == true)" Size="Size.Small" />
            <Button Color="Color.Light" Clicked="@(( MouseEventArgs _ ) => RemoveSetting( setting ))" Disabled="@(Context?.Disabled == true)" Size="Size.Small" title="@Localize( "Remove setting" )" aria-label="@Localize( "Remove setting" )">
                <Icon Name="@IconName.Delete" />
            </Button>
        </Div>
    }
    <Div>
        <Button Color="Color.Light" Clicked="@AddSetting" Disabled="@(Context?.Disabled == true)" Size="Size.Small">
            <Icon Name="@IconName.Add" Margin="MarginIs1FromEnd" />
            @Localize( "Add setting" )
        </Button>
    </Div>
</Div>