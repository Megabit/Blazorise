@namespace Blazorise.Reporting.Internal
@inherits BaseReportComponent

<Div Class="b-report-viewer"
     Padding="PaddingIs3"
     Border="BorderIs1"
     Overflow="OverflowAuto">
    @if ( !Designer.HasPreviewFormats )
    {
        <Div Class="b-report-preview-message"
             Padding="PaddingIs5"
             Border="BorderIs1"
             TextAlignment="TextAlignmentCenter">
            @Localize( "No preview formats are enabled." )
        </Div>
    }
    else if ( Designer.ActivePreviewFormat == ReportPreviewFormat.Pdf )
    {
        ReportPdfPreviewContext pdfPreviewContext = Designer.PdfPreviewContext;

        if ( pdfPreviewContext is not null )
        {
            if ( Designer.PdfPreviewTemplate is not null )
            {
                @Designer.PdfPreviewTemplate( pdfPreviewContext )
            }
            else
            {
                <Div Class="b-report-preview-message"
                     Padding="PaddingIs5"
                     Border="BorderIs1"
                     TextAlignment="TextAlignmentCenter">
                    <Div Margin="MarginIs3FromBottom">
                        @(pdfPreviewContext.AllowDownload ? Localize( "PDF preview is available for download." ) : Localize( "PDF preview has been generated." ))
                    </Div>
                    @if ( pdfPreviewContext.AllowDownload )
                    {
                        <Button Color="Color.Primary" Clicked="@pdfPreviewContext.Download">
                            <Icon Name="IconName.FileDownload" Margin="MarginIs2FromEnd" />
                            @Localize( "Download PDF" )
                        </Button>
                    }
                </Div>
            }
        }
        else
        {
            <Div Class="b-report-preview-message"
                 Padding="PaddingIs5"
                 Border="BorderIs1"
                 TextAlignment="TextAlignmentCenter">
                @Localize( "Generating PDF preview..." )
            </Div>
        }
    }
    else
    {
        ReportDefinition definition = Designer.PreviewDefinition;

        <Div Class="b-report-viewer-pages">
            @foreach ( ReportRenderPage renderPage in Designer.ResolvePreviewRenderPages( definition ) )
            {
                ReportDefinition pageDefinition = renderPage.Definition;
                string renderPageKey = $"{pageDefinition.Page.Id}:{renderPage.PageNumber}";

                <_ReportDesignerPage PageKey="@renderPageKey"
                                     Width="@pageDefinition.Page.Width"
                                     MinHeight="@pageDefinition.Page.Height"
                                     Height="@pageDefinition.Page.Height">
                    <Div Class="b-report-page-content" Style="@Designer.GetPreviewPageContentStyle( pageDefinition )">
                        <_ReportPreviewSections TSection="ReportRenderSection"
                                                Designer="@Designer"
                                                Definition="@pageDefinition"
                                                Sections="@renderPage.HeaderSections"
                                                PageNumber="@renderPage.PageNumber"
                                                KeySuffix="header" />
                        <_ReportPreviewSections TSection="ReportRenderSection"
                                                Designer="@Designer"
                                                Definition="@pageDefinition"
                                                Sections="@renderPage.BodySections"
                                                PageNumber="@renderPage.PageNumber"
                                                KeySuffix="body" />
                    </Div>
                    @if ( renderPage.FooterSections.Count > 0 )
                    {
                        <Div Class="b-report-page-footer-content" Style="@Designer.GetPreviewPageFooterStyle( pageDefinition, renderPage )">
                            <_ReportPreviewSections TSection="ReportRenderSection"
                                                    Designer="@Designer"
                                                    Definition="@pageDefinition"
                                                    Sections="@renderPage.FooterSections"
                                                    PageNumber="@renderPage.PageNumber"
                                                    KeySuffix="footer" />
                        </Div>
                    }
                </_ReportDesignerPage>
            }
        </Div>
    }
</Div>