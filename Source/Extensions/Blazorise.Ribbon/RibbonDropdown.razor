@inherits BaseRibbonItem
<Dropdown @ref="@dropdownRef" ElementId="@ElementId" Class="@ClassNames" Style="@StyleNames" Height="@(Height is null ? EffectiveHeight : null)" Disabled="@Disabled" Direction="@Direction" Visible="@Visible" VisibleChanged="@OnVisibleChangedHandler" @attributes="@Attributes">
    <DropdownToggle @ref="@toggleRef" Color="@Color" Ghost Size="Blazorise.Size.Small" Border="Blazorise.Border.Is0" Flex="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Flex.InlineFlex.Column.NoWrap.AlignItems.Center.JustifyContent.Center : Blazorise.Flex.InlineFlex.Row.NoWrap.AlignItems.Center.JustifyContent.Center)" Height="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Height.Is100 : null)" Padding="Blazorise.Padding.Is1" TextSize="Blazorise.TextSize.Px( 13 )" TextOverflow="Blazorise.TextOverflow.NoWrap" aria-label="@Text" title="@Text">
        <_RibbonCommandContent Text="@Text" Icon="@Icon" Size="@EffectiveSize" ChildContent="@HeaderContent" />
    </DropdownToggle>
    <DropdownMenu>
        @ChildContent
    </DropdownMenu>
</Dropdown>