@inherits BaseRibbonItem
<Dropdown @ref="@dropdownRef" ElementId="@ElementId" Class="@ClassNames" Style="@StyleNames" Height="@(Height is null ? EffectiveHeight : null)" Disabled="@Disabled" Direction="@Direction" DropdownMenuTargetId="@ElementId" Visible="@Visible" VisibleChanged="@OnVisibleChangedHandler" @attributes="@Attributes">
    <Div Flex="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Flex.InlineFlex.Column.NoWrap.AlignItems.Stretch : Blazorise.Flex.InlineFlex.Row.NoWrap.AlignItems.Stretch)" Height="Blazorise.Height.Is100">
        <Button Color="@Color" TextColor="@EffectiveTextColor" Height="Blazorise.Height.Auto" Ghost Size="Blazorise.Size.Small" Border="Blazorise.Border.Is0" Flex="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Flex.Grow.Is1.Basis.Is0 : Blazorise.Flex.Grow.Is1)" Padding="Blazorise.Padding.Is1" TextSize="Blazorise.TextSize.Px( 13 )" TextOverflow="Blazorise.TextOverflow.NoWrap" Disabled="@Disabled" Clicked="@OnClickHandler" aria-label="@Text" title="@Text">
            <_RibbonCommandContent Text="@Text" Icon="@Icon" Size="@EffectiveSize" ShowText="@(EffectiveSize != RibbonItemSize.Large)" ChildContent="@HeaderContent" />
        </Button>
        <DropdownToggle @ref="@toggleRef" Color="@Color" TextColor="@EffectiveTextColor" Height="Blazorise.Height.Auto" Ghost Size="Blazorise.Size.Small" Border="Blazorise.Border.Is0" Flex="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Flex.InlineFlex.Column.NoWrap.AlignItems.Center.JustifyContent.Around.Grow.Is1.Basis.Is0 : Blazorise.Flex.Shrink.Is0)" Width="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Width.Is100 : null)" Padding="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Padding.Is1 : Blazorise.Padding.Is1.OnX.Is0.OnY)" TextSize="Blazorise.TextSize.Px( 13 )" aria-label="@EffectiveMenuLabel">
            @if ( EffectiveSize == RibbonItemSize.Large )
            {
                <Span>@Text</Span>
            }
        </DropdownToggle>
    </Div>
    <DropdownMenu>
        @ChildContent
    </DropdownMenu>
</Dropdown>