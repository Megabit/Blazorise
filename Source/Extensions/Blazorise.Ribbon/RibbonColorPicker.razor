@inherits BaseRibbonItem
<ColorPicker @ref="@pickerRef" ElementId="@ElementId" Class="@ClassNames" Style="@StyleNames" Height="@(Height is null ? EffectiveHeight : null)" Width="Blazorise.Width.Auto" TextColor="@EffectiveTextColor" Background="Blazorise.Background.Transparent" Value="@Value" ValueChanged="@OnValueChangedHandler" ShowValue="@ShowValue" Size="Blazorise.Size.Small" Disabled="@Disabled" ReadOnly="@ReadOnly" Palette="@Palette" ShowPalette="@ShowPalette" HideAfterPaletteSelect="@HideAfterPaletteSelect" ShowClearButton="@ShowClearButton" ShowCancelButton="@ShowCancelButton" ShowOpacitySlider="@ShowOpacitySlider" ShowHueSlider="@ShowHueSlider" ShowInputField="@ShowInputField" PickerLocalizer="@PickerLocalizer" PreviewContent="@(ChildContent ?? ( Icon is not null ? IconContent : null ))" aria-label="@Text" title="@Text" @attributes="@Attributes" />

@code {
    private RenderFragment IconContent => __builder =>
    {
        <Span Flex="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Flex.Column.AlignItems.Center.JustifyContent.Center : Blazorise.Flex.Row.AlignItems.Center)" Height="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Height.Is100 : null)" Gap="Blazorise.Gap.Is1">
            <Span Flex="Blazorise.Flex.Column.AlignItems.Center" aria-hidden="true">
                <Icon Name="@Icon" IconSize="@(EffectiveSize == RibbonItemSize.Large ? IconSize.x2 : IconSize.Default)" TextSize="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.TextSize.Em( 2 ) : Blazorise.TextSize.Em( 1 ))" FixedWidth />
                <Span Display="Blazorise.Display.Block" Width="@(EffectiveSize == RibbonItemSize.Large ? Blazorise.Width.Em( 2 ) : Blazorise.Width.Em( 1 ))" Height="Blazorise.Height.Px( 3 )" Background="@EffectiveIndicatorBackground" />
            </Span>
            @if ( EffectiveSize != RibbonItemSize.Small )
            {
                <Span>@Text</Span>
            }
        </Span>
    };
}