@inherits BaseComponent
@if ( HasSubmenu )
{
    <Dropdown Disabled="@Disabled">
        <DropdownToggle ElementId="@ElementId" Class="@ClassNames" Style="@StyleNames" Disabled="@Disabled" ShowToggleIcon="true" aria-label="@Text" @attributes="@Attributes">
            <_RibbonCommandContent Text="@Text" Icon="@Icon" Size="RibbonItemSize.Medium" />
        </DropdownToggle>
        <DropdownMenu>
            @ChildContent
        </DropdownMenu>
    </Dropdown>
}
else
{
    <DropdownItem ElementId="@ElementId" Class="@ClassNames" Style="@StyleNames" Disabled="@Disabled" Clicked="@OnClickHandler" @attributes="@Attributes">
        <_RibbonCommandContent Text="@Text" Icon="@Icon" Size="RibbonItemSize.Medium" />
    </DropdownItem>
}