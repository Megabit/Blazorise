@inherits Blazorise.ColorPicker
<CascadingValue Value="@this">
    <Div Class="@PickerContainerClassNames" Style="@PickerContainerStyleNames" data-show-value="@ShowValueString">
        <button @ref="@ElementRef" id="@ElementId" type="button" name="@NameAttributeValue" class="@ClassNames" style="@StyleNames" disabled="@IsDisabled" value="@CurrentValueAsString" data-color="@CurrentValueAsString" data-show-value="@ShowValueString" data-custom-preview="@CustomPreviewString" aria-haspopup="dialog" aria-expanded="@AriaExpandedString" aria-controls="@MenuElementId" tabindex="@TabIndex" aria-disabled="@AriaDisabledString" aria-invalid="@ResolvedAriaInvalid" aria-required="@ResolvedAriaRequired" aria-describedby="@ResolvedAriaDescribedBy" aria-labelledby="@ResolvedAriaLabelledBy" @onclick="@OnClickHandler" @onkeydown="@OnKeyDownHandler" @onkeypress="@OnKeyPressHandler" @onkeyup="@OnKeyUpHandler" @onblur="@OnBlurHandler" @onfocus="@OnFocusHandler" @onfocusin="@OnFocusInHandler" @onfocusout="@OnFocusOutHandler" @attributes="@Attributes">
        <Span Class="@PreviewClassNames">
            @if ( PreviewContent is not null )
            {
                @PreviewContent
            }
            else
            {
                <Span Class="@SwatchClassNames" Style="@SwatchStyleNames" />
            }
            @if ( ShowValue )
            {
                <Span Class="ant-input-color-picker-current-value ant-color-picker-trigger-text">@CurrentValueAsString</Span>
            }
        </Span>
        </button>
        @if ( IsPickerVisible )
        {
            <_ColorPickerMenu />
        }
    </Div>
</CascadingValue>
@ChildContent
@Feedback
@code {
    /// <inheritdoc/>
    protected override void BuildClasses( Blazorise.Utilities.ClassBuilder builder )
    {
        builder.Append( "ant-color-picker-trigger" );
        builder.Append( "ant-color-picker-trigger-disabled", IsDisabled );

        base.BuildClasses( builder );
    }

    /// <inheritdoc/>
    protected override void BuildSwatchClasses( Blazorise.Utilities.ClassBuilder builder )
    {
        builder.Append( "ant-color-picker-color-block" );

        base.BuildSwatchClasses( builder );
    }
}