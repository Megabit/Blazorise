@inherits Blazorise.Steps
<CascadingValue Value="@this" IsFixed>
    <CascadingValue Value="State">
        @if ( Items is not null && Content is not null )
        {
            <ul @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tablist" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-orientation="horizontal" @attributes="@Attributes">
                @Items
            </ul>
            <div class="@ContentClassNames" style="@Styles?.Content">
                @Content
            </div>
        }
        else
        {
            <ul @ref="@ElementRef" id="@ElementId" class="@ClassNames" style="@StyleNames" role="tablist" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-orientation="horizontal" @attributes="@Attributes">
                @( Items ?? ChildContent )
            </ul>
        }
    </CascadingValue>
</CascadingValue>