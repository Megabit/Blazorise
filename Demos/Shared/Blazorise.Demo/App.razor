@*
    The Router component displays whichever component has a @page
    directive matching the current URI.
*@
@using System.Reflection
<AppProviders>
    <Router AppAssembly="typeof( App ).Assembly" AdditionalAssemblies="@additionalAssemblies">
        <Found Context="routeData">
            <CascadingValue Value="routeData">
                <RouteView RouteData="routeData" DefaultLayout="typeof( MainLayout )" />
            </CascadingValue>
        </Found>
        <NotFound>
            <p>Sorry, there's nothing at this address.</p>
        </NotFound>
    </Router>
</AppProviders>
@code {
    private static readonly Assembly[] additionalAssemblies =
    [
        typeof( Blazorise.Demo.Charts.DemoChartsAssemblyMarker ).Assembly,
        typeof( Blazorise.Demo.Components.DemoComponentsAssemblyMarker ).Assembly,
        typeof( Blazorise.Demo.DataGrid.DemoDataGridAssemblyMarker ).Assembly,
        typeof( Blazorise.Demo.Extensions.DemoExtensionsAssemblyMarker ).Assembly,
        typeof( Blazorise.Demo.Reporting.DemoReportingAssemblyMarker ).Assembly,
    ];
}