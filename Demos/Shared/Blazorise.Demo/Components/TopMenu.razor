    private string gitHubDemoUrl;

    protected override void OnInitialized()
    {
        if ( NavigationManager is not null )
        {
            DetermineCurrentUrl();

            NavigationManager.LocationChanged += OnLocationChanged;
        }
    }

    private void OnLocationChanged( object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e )
    {
        DetermineCurrentUrl();

        InvokeAsync( StateHasChanged );
    }

    private void DetermineCurrentUrl()
    {
        var url = NavigationManager.ToBaseRelativePath( NavigationManager.Uri );

        if ( demoToGitHubMapping.TryGetValue( url, out var gh ) )
        {
            gitHubDemoUrl = gh.StartsWith( "Blazorise.Demo", StringComparison.Ordinal )
                ? $"https://github.com/Megabit/Blazorise/blob/master/Demos/Shared/{gh}"
                : $"https://github.com/Megabit/Blazorise/blob/master/Demos/Shared/Blazorise.Demo/{gh}";
        }
        else
        {
            gitHubDemoUrl = null;
        }
    }

    private Task OnThemeColorChanged( Color variant, string value )
    {
        return ThemeColorChanged.InvokeAsync( new( variant, value ) );
    }

    void IDisposable.Dispose()
    {
        if ( NavigationManager is not null )
        {
            NavigationManager.LocationChanged -= OnLocationChanged;
        }
    }

    [Parameter] public EventCallback<bool> ThemeEnabledChanged { get; set; }

    [Parameter] public EventCallback<ThemeColorChangedEventArgs> ThemeColorChanged { get; set; }

    [Parameter] public string LayoutType { get; set; }

    [Parameter] public EventCallback<string> LayoutTypeChanged { get; set; }

    [Inject] protected ITextLocalizerService LocalizationService { get; set; }

    [Inject] protected BlazoriseOptions BlazoriseOptions { get; set; }

    [Inject] protected IOnScreenKeyboardService OnScreenKeyboardService { get; set; }

    [CascadingParameter] protected Theme Theme { get; set; }

    private BlazoriseAccessibilityOptions AccessibilityOptions => BlazoriseOptions.AccessibilityOptions ??= new();

    private BlazoriseOnScreenKeyboardOptions OnScreenKeyboardOptions => AccessibilityOptions.OnScreenKeyboard ??= new();

    private bool OnScreenKeyboardEnabled => OnScreenKeyboardOptions.Enabled;

    private bool UseLabelForAttribute => AccessibilityOptions.UseLabelForAttribute;

    private bool UseAriaLabelledByAttribute => AccessibilityOptions.UseAriaLabelledByAttribute;

    private bool UseAutoAriaInvalidAttribute => AccessibilityOptions.UseAutoAriaInvalidAttribute;

    private bool UseAutoAriaDescribedByAttribute => AccessibilityOptions.UseAutoAriaDescribedByAttribute;

    private bool UseAutoAriaRequiredAttribute => AccessibilityOptions.UseAutoAriaRequiredAttribute;

    private bool UseValidationOnBlur => AccessibilityOptions.UseValidationOnBlur;
