@using Blazorise.Localization
@using System
@using System.Collections.Generic
@inject NavigationManager NavigationManager
@implements IDisposable

<Bar @bind-Visible="@topbarVisible" Breakpoint="Breakpoint.Desktop" Background="Background.White" Shadow="Shadow.Default" ThemeContrast="ThemeContrast.Light">
    <BarBrand>
        <BarItem>
            <BarLink To="">
                <BarIcon IconName="IconName.Dashboard" />
                Blazorise Demo
            </BarLink>
        </BarItem>
    </BarBrand>
    <BarToggler />
    <BarMenu>
        <BarStart>
            <BarItem>
                <BarLink To="https://blazorise.com/">Home</BarLink>
            </BarItem>
            <BarItem>
                <BarLink To="https://blazorise.com/docs/">Documentation</BarLink>
            </BarItem>
            <BarItem>
                <BarDropdown>
                    <BarDropdownToggle>More</BarDropdownToggle>
                    <BarDropdownMenu>
                        <BarDropdownItem To="https://blazorise.com/docs/start/">
                            Quick-Start Guide
                        </BarDropdownItem>
                        <BarDropdownDivider />
                        <BarDropdownItem To="https://blazorise.com/docs/usage/">
                            Usage
                        </BarDropdownItem>
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem>
            <BarItem>
                <BarDropdown>
                    <BarDropdownToggle>Layout</BarDropdownToggle>
                    <BarDropdownMenu>
                        <BarDropdownItem Clicked="@(() => OnLayoutTypeChecked( "fixed-header" ))">
                            @if ( LayoutType == "fixed-header" )
                            {
                                <Icon Name="IconName.CheckCircle" TextColor="TextColor.Success" />
                            }
                            Fixed Header
                        </BarDropdownItem>
                        <BarDropdownItem Clicked="@(() => OnLayoutTypeChecked( "fixed-header-footer-only" ))">
                            @if ( LayoutType == "fixed-header-footer-only" )
                            {
                                <Icon Name="IconName.CheckCircle" TextColor="TextColor.Success" />
                            }
                            Fixed Header and Footer only
                        </BarDropdownItem>
                        <BarDropdownItem Clicked="@(() => OnLayoutTypeChecked( "sider-with-header-on-top" ))">
                            @if ( LayoutType == "sider-with-header-on-top" )
                            {
                                <Icon Name="IconName.CheckCircle" TextColor="TextColor.Success" />
                            }
                            Sider with Header on top
                        </BarDropdownItem>
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem>

            <BarItem>
                <BarDropdown>
                    <BarDropdownToggle>Level1</BarDropdownToggle>
                    <BarDropdownMenu>
                        <BarDropdownItem>Level1.1</BarDropdownItem>
                        <BarDropdown>
                            <BarDropdownToggle>Level2</BarDropdownToggle>
                            <BarDropdownMenu>
                                <BarDropdownItem>Level2.1</BarDropdownItem>
                                <BarDropdown>
                                    <BarDropdownToggle>Level3</BarDropdownToggle>
                                    <BarDropdownMenu>
                                        <BarDropdownItem>Level3.1</BarDropdownItem>
                                    </BarDropdownMenu>
                                </BarDropdown>
                            </BarDropdownMenu>
                        </BarDropdown>
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem>
        </BarStart>
        <BarEnd>
            <BarItem>
                <Button Clicked="@ShowSettings" aria-label="Settings">
                    <Icon Name="IconName.Settings" />
                </Button>
            </BarItem>
            @if ( gitHubDemoUrl != null )
            {
                <BarItem>
                    <BarLink To="@gitHubDemoUrl" Target="Target.Blank">
                        <Icon Name="IconName.Code" />
                    </BarLink>
                </BarItem>
            }
            <BarItem>
                <BarLink To="https://github.com/Megabit/Blazorise" Target="Target.Blank">GitHub</BarLink>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

<Offcanvas @ref="settingsOffcanvas" Placement="Placement.End" Size="OffcanvasSize.Large" ShowBackdrop="false">
    <OffcanvasHeader>
        Settings
        <CloseButton Clicked="@HideSettings" />
    </OffcanvasHeader>
    <OffcanvasBody>
        <Heading Size="HeadingSize.Is5" Margin="Margin.Is3.FromBottom">Language</Heading>
        <Field Margin="Margin.Is4.FromBottom">
            <FieldLabel>Display language</FieldLabel>
            <Select TValue="string" Value="@LocalizationService.SelectedCulture.Name" ValueChanged="@SelectCulture">
                @foreach ( var cultureInfo in LocalizationService.AvailableCultures )
                {
                    <SelectItem @key="@cultureInfo.Name" Value="@cultureInfo.Name">
                        @if ( cultureInfo.IsNeutralCulture )
                        {
                            @cultureInfo.EnglishName
                        }
                        else
                        {
                            @cultureInfo.Parent.EnglishName
                        }
                    </SelectItem>
                }
            </Select>
        </Field>

        <Divider Margin="Margin.Is4.OnY" />

        <Heading Size="HeadingSize.Is5" Margin="Margin.Is3.FromBottom">Theme</Heading>
        <Fields>
            <Field ColumnSize="ColumnSize.Is12">
                <Switch TValue="bool" Value="@(Theme?.Enabled == true)" ValueChanged="@ThemeEnabledChanged">Theme enabled</Switch>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Primary</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Primary)" ValueChanged="@( value => OnThemeColorChanged( Color.Primary, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Secondary</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Secondary)" ValueChanged="@( value => OnThemeColorChanged( Color.Secondary, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Success</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Success)" ValueChanged="@( value => OnThemeColorChanged( Color.Success, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Danger</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Danger)" ValueChanged="@( value => OnThemeColorChanged( Color.Danger, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Warning</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Warning)" ValueChanged="@( value => OnThemeColorChanged( Color.Warning, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Info</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Info)" ValueChanged="@( value => OnThemeColorChanged( Color.Info, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Light</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Light)" ValueChanged="@( value => OnThemeColorChanged( Color.Light, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
            <Field ColumnSize="ColumnSize.Is6">
                <FieldLabel>Dark</FieldLabel>
                <FieldBody>
                    <ColorPicker Value="@(Theme?.ColorOptions?.Dark)" ValueChanged="@( value => OnThemeColorChanged( Color.Dark, value ))" ShowClearButton="false" ShowCancelButton="false" ShowOpacitySlider="false" />
                </FieldBody>
            </Field>
        </Fields>

        <Divider Margin="Margin.Is4.OnY" />

        <Heading Size="HeadingSize.Is5" Margin="Margin.Is3.FromBottom">Accessibility</Heading>
        <Field>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3">
                <Switch TValue="bool" Value="@OnScreenKeyboardEnabled" ValueChanged="@OnScreenKeyboardEnabledChanged">On-screen keyboard</Switch>
                <Tooltip Text="Shows a virtual keyboard when supported text inputs receive focus." Placement="TooltipPlacement.Left" Multiline>
                    <Icon Name="IconName.QuestionCircle" TextColor="TextColor.Secondary" />
                </Tooltip>
            </Div>
        </Field>
        <Field>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3">
                <Switch TValue="bool" Value="@UseLabelForAttribute" ValueChanged="@UseLabelForAttributeChanged">Label for attributes</Switch>
                <Tooltip Text="Connects labels to inputs with the HTML for attribute." Placement="TooltipPlacement.Left" Multiline>
                    <Icon Name="IconName.QuestionCircle" TextColor="TextColor.Secondary" />
                </Tooltip>
            </Div>
        </Field>
        <Field>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3">
                <Switch TValue="bool" Value="@UseAriaLabelledByAttribute" ValueChanged="@UseAriaLabelledByAttributeChanged">aria-labelledby attributes</Switch>
                <Tooltip Text="Adds aria-labelledby so assistive technologies can announce related labels." Placement="TooltipPlacement.Left" Multiline>
                    <Icon Name="IconName.QuestionCircle" TextColor="TextColor.Secondary" />
                </Tooltip>
            </Div>
        </Field>
        <Field>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3">
                <Switch TValue="bool" Value="@UseAutoAriaInvalidAttribute" ValueChanged="@UseAutoAriaInvalidAttributeChanged">aria-invalid attributes</Switch>
                <Tooltip Text="Sets aria-invalid automatically when validation marks an input invalid." Placement="TooltipPlacement.Left" Multiline>
                    <Icon Name="IconName.QuestionCircle" TextColor="TextColor.Secondary" />
                </Tooltip>
            </Div>
        </Field>
        <Field>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3">
                <Switch TValue="bool" Value="@UseAutoAriaDescribedByAttribute" ValueChanged="@UseAutoAriaDescribedByAttributeChanged">aria-describedby attributes</Switch>
                <Tooltip Text="Sets aria-describedby automatically for validation or help text associated with an input." Placement="TooltipPlacement.Left" Multiline>
                    <Icon Name="IconName.QuestionCircle" TextColor="TextColor.Secondary" />
                </Tooltip>
            </Div>
        </Field>
        <Field>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3">
                <Switch TValue="bool" Value="@UseAutoAriaRequiredAttribute" ValueChanged="@UseAutoAriaRequiredAttributeChanged">aria-required attributes</Switch>
                <Tooltip Text="Sets aria-required automatically for required inputs." Placement="TooltipPlacement.Left" Multiline>
                    <Icon Name="IconName.QuestionCircle" TextColor="TextColor.Secondary" />
                </Tooltip>
            </Div>
        </Field>
        <Field>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3">
                <Switch TValue="bool" Value="@UseValidationOnBlur" ValueChanged="@UseValidationOnBlurChanged">Validate on blur</Switch>
                <Tooltip Text="Runs validation when an input loses focus." Placement="TooltipPlacement.Left" Multiline>
                    <Icon Name="IconName.QuestionCircle" TextColor="TextColor.Secondary" />
                </Tooltip>
            </Div>
        </Field>
    </OffcanvasBody>
</Offcanvas>
@code {
    protected override async Task OnInitializedAsync()
    {
        await SelectCulture( "en-US" );

        await base.OnInitializedAsync();
    }

    Task SelectCulture( string name )
    {
        LocalizationService.ChangeLanguage( name );

        return Task.CompletedTask;
    }

    private Task ShowSettings()
    {
        return settingsOffcanvas.Show();
    }

    private Task HideSettings()
    {
        return settingsOffcanvas.Hide();
    }

    private bool topbarVisible = false;

    private Offcanvas settingsOffcanvas;

    Task OnLayoutTypeChecked( string layoutType )
    {
        LayoutType = layoutType;

        return LayoutTypeChanged.InvokeAsync( layoutType );
    }

    private async Task OnScreenKeyboardEnabledChanged( bool value )
    {
        OnScreenKeyboardOptions.Enabled = value;

        if ( !value )
        {
            await OnScreenKeyboardService.Hide();
        }

        StateHasChanged();
    }

    private Task SetAccessibilityOption( Action<BlazoriseAccessibilityOptions> action )
    {
        action?.Invoke( AccessibilityOptions );

        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task UseLabelForAttributeChanged( bool value )
    {
        return SetAccessibilityOption( option => option.UseLabelForAttribute = value );
    }

    private Task UseAriaLabelledByAttributeChanged( bool value )
    {
        return SetAccessibilityOption( option => option.UseAriaLabelledByAttribute = value );
    }

    private Task UseAutoAriaInvalidAttributeChanged( bool value )
    {
        return SetAccessibilityOption( option => option.UseAutoAriaInvalidAttribute = value );
    }

    private Task UseAutoAriaDescribedByAttributeChanged( bool value )
    {
        return SetAccessibilityOption( option => option.UseAutoAriaDescribedByAttribute = value );
    }

    private Task UseAutoAriaRequiredAttributeChanged( bool value )
    {
        return SetAccessibilityOption( option => option.UseAutoAriaRequiredAttribute = value );
    }

    private Task UseValidationOnBlurChanged( bool value )
    {
        return SetAccessibilityOption( option => option.UseValidationOnBlur = value );
    }

