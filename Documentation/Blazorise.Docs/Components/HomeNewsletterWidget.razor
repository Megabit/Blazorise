@using Blazorise.Docs.Services
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using System.Text.Json
<Div Class="b-newsletter-signup">
    <Div Class="b-newsletter-signup__intro">
        <Paragraph Class="b-newsletter-signup__eyebrow">THE BLAZORISE NEWSLETTER</Paragraph>
        @if ( ShowHeading )
        {
            <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Stay in the loop.</Heading>
        }
        <Paragraph>New releases, practical guides, and fresh ideas for your next Blazor app. Delivered to your inbox.</Paragraph>
    </Div>
    <Div Class="b-newsletter-signup__form">
        <Validations @ref="@validationsRef" Mode="ValidationMode.Manual" ValidateOnLoad>
            @if ( emailSent )
            {
                <Alert Color="Color.Success" Visible aria-live="polite">
                    <AlertDescription>
                        Thank you for subscribing.
                    </AlertDescription>
                </Alert>
            }
            else
            {
                <Div Class="b-newsletter-signup__entry">
                    <Validation Validator="ValidationRule.IsEmail">
                        <Field Margin="Margin.Is0">
                            <FieldLabel For="home-newsletter-email" Display="Display.Block" Margin="Margin.Is2.FromBottom" TextWeight="TextWeight.SemiBold">Email address</FieldLabel>
                            <TextInput ElementId="home-newsletter-email" Role="TextRole.Email" Placeholder="you@example.com" @bind-Value="@email" autocomplete="email">
                                <Feedback>
                                    <ValidationError TextColor="TextColor.Danger">Enter a valid email address.</ValidationError>
                                </Feedback>
                            </TextInput>
                        </Field>
                    </Validation>
                    <Button Color="Color.Primary" Clicked="@OnSubscribeClicked" Class="b-newsletter-signup__submit" Flex="Flex.InlineFlex.AlignItems.Center.JustifyContent.Center" Gap="Gap.Is3">Subscribe <Span aria-hidden="true">&#8594;</Span></Button>
                </Div>
                <Div Class="b-newsletter-signup__consent" Margin="Margin.Is4.FromTop">
                    <Validation Validator="ValidationRule.IsChecked">
                        <Field Margin="Margin.Is2.FromBottom">
                            <Check @bind-Value="@termsAgreed">
                                <ChildContent>
                                    I agree to the <Anchor To="terms">Terms &amp; Conditions</Anchor> and <Anchor To="privacy">Privacy Policy</Anchor>.
                                </ChildContent>
                                <Feedback>
                                    <ValidationError TextColor="TextColor.Danger">You must agree to our terms and privacy policy.</ValidationError>
                                </Feedback>
                            </Check>
                        </Field>
                    </Validation>
                    <Field Margin="Margin.Is0.FromBottom">
                        <Check TValue="bool" @bind-Value="@marketingAgreed">
                            I would like to receive marketing materials like product deals &amp; special offers.
                        </Check>
                    </Field>
                </Div>
            }
        </Validations>
    </Div>
</Div>

@code {
    Validations validationsRef;
    string email;
    bool termsAgreed;
    bool marketingAgreed;
    bool emailSent;

    [Parameter] public bool ShowHeading { get; set; } = true;

    [Parameter] public bool Small { get; set; }

    [Inject] public ILogger<NewsletterWidget> Logger { get; set; }

    [Inject] public IBrevoApiClient BrevoApiClient { get; set; }

    class CustomFieldsResult
    {
        public List<CustomField> custom_fields { get; set; }

        public class CustomField
        {
            public string id { get; set; }
            public string name { get; set; }
            public string type { get; set; }
        }
    }

    async Task OnSubscribeClicked()
    {
        emailSent = false;

        try
        {
            if ( await validationsRef.ValidateAll() )
            {
                var response = await BrevoApiClient.CreateContactAsync( email, null, [2] );

                if ( response != null )
                {
                    email = null;
                    emailSent = true;
                }

                await validationsRef.ClearAll();
            }
        }
        catch ( Exception exc )
        {
            Logger.LogError( exc.Message );
        }
    }
}