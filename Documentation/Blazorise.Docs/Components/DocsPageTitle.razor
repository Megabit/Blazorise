@if ( Path != null )
{
    <Breadcrumb>
        @{
            var pathValues = Path.Split( '/' ).Where( x => !string.IsNullOrEmpty( x ) ).ToList();
            var routeValues = ( RoutePath ?? Path ).Split( '/' ).Where( x => !string.IsNullOrEmpty( x ) ).ToList();

            var isLast = pathValues.Count == 0;
            var url = "docs";
        }

        <BreadcrumbItem Active="@isLast">
            <BreadcrumbLink To="docs">Documentation</BreadcrumbLink>
        </BreadcrumbItem>

        @if ( pathValues.Count > 0 )
        {
            @for ( var i = 0; i < pathValues.Count; i++ )
            {
                var pathValue = pathValues[i];
                var routeValue = i < routeValues.Count ? routeValues[i] : pathValue;
                isLast = i == pathValues.Count - 1;
                url = $"{url}/{routeValue.ToLowerInvariant()}";
                var currentUrl = url;

                <BreadcrumbItem Active="@isLast">
                    <BreadcrumbLink To="@currentUrl">@pathValue</BreadcrumbLink>
                </BreadcrumbItem>
            }
        }
    </Breadcrumb>
}

@if ( !string.IsNullOrEmpty( AddedVersion ) )
{
    <Div Flex="Flex.Default.OnDesktop.Flex.ReverseRow.OnDesktop.JustifyContent.Between.AlignItems.Center">
        <Alert Visible Flex="Flex.InlineFlex" Color="Color.Success" Padding="Padding.Is2.OnX.Is1.OnY" TextWeight="TextWeight.SemiBold" title="@AddedDate">
            Added in v@( AddedVersion )
        </Alert>
        @HeadingFragment
    </Div>
}
else
{
    @HeadingFragment
}

@code {
    [Parameter] public bool Display { get; set; }

    [Parameter] public string Path { get; set; }

    /// <summary>
    /// Gets or sets the route segments relative to docs, matching the labels in <see cref="Path"/>.
    /// Missing route segments fall back to their corresponding labels.
    /// </summary>
    [Parameter] public string RoutePath { get; set; }

    /// <summary>
    /// Gets or sets the version that introduced the page, without the display prefix.
    /// </summary>
    [Parameter] public string AddedVersion { get; set; }

    /// <summary>
    /// Gets or sets the date the page was added, in yyyy-MM-dd format.
    /// </summary>
    [Parameter] public string AddedDate { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }

    private RenderFragment HeadingFragment => __builder =>
    {
        @if ( Display )
        {
            <DisplayHeading ElementId="b-docs-page-title" Size="DisplayHeadingSize.Is1" Margin="Margin.Is4.FromBottom">
                @ChildContent
            </DisplayHeading>
        }
        else
        {
            <Heading ElementId="b-docs-page-title" Size="HeadingSize.Is1" Margin="Margin.Is4.FromBottom">
                @ChildContent
            </Heading>
        }
    };
}