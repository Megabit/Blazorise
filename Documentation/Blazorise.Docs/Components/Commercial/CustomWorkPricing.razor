<Container ElementId="pricing" Padding="Padding.Is5.OnY">
    <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">
        Pricing at a glance
    </Heading>

    <Table Responsive Bordered Striped>
        <TableHeader>
            <TableRow>
                <TableHeaderCell TextAlignment="TextAlignment.Start">Offering</TableHeaderCell>
                <TableHeaderCell TextAlignment="TextAlignment.Start">Best for</TableHeaderCell>
                <TableHeaderCell TextAlignment="TextAlignment.Start">Commercial model</TableHeaderCell>
                <TableHeaderCell TextAlignment="TextAlignment.End">Price guidance (EUR)</TableHeaderCell>
            </TableRow>
        </TableHeader>
        <TableBody>
            <TableRow>
                <TableRowCell TextAlignment="TextAlignment.Start"><Strong>License support</Strong></TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Normal asynchronous product support</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Included with applicable commercial licenses</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.End">Included</TableRowCell>
            </TableRow>
            <TableRow>
                <TableRowCell TextAlignment="TextAlignment.Start"><Strong>Live Expert Support</Strong></TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Short, hands-on Blazor troubleshooting and guidance</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Hourly, 1-hour minimum</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.End">€150 / hour</TableRowCell>
            </TableRow>
            <TableRow>
                <TableRowCell TextAlignment="TextAlignment.Start"><Strong>Priority Expert Support</Strong></TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Expedited help for blocking issues or approaching deadlines</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Hourly, 1-hour minimum</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.End">€200 / hour</TableRowCell>
            </TableRow>
            <TableRow>
                <TableRowCell TextAlignment="TextAlignment.Start"><Strong>Emergency Expert Support</Strong></TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Immediate or out-of-hours help when available</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Hourly, 1-hour minimum</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.End">From €250 / hour</TableRowCell>
            </TableRow>
            <TableRow>
                <TableRowCell TextAlignment="TextAlignment.Start"><Strong>Feature Sponsorship</Strong></TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Generalizable features intended to go upstream</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Fixed price</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.End">3.500-45.000+</TableRowCell>
            </TableRow>
            <TableRow>
                <TableRowCell TextAlignment="TextAlignment.Start"><Strong>Custom Development</Strong></TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Company-specific work, integrations, and bespoke needs</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Time &amp; materials</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.End">95-120 / hour</TableRowCell>
            </TableRow>
            <TableRow>
                <TableRowCell TextAlignment="TextAlignment.Start"><Strong>Priority Development Queue</Strong></TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Faster triage, voting, and roadmap transparency (no delivery)</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Start">Annual add-on</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.End">4.900 / year</TableRowCell>
            </TableRow>
        </TableBody>
    </Table>

    <Paragraph TextAlignment="TextAlignment.Center" TextColor="TextColor.Muted">
        Quotes are provided in EUR (typically excluding VAT unless stated). Final pricing depends on scope, acceptance criteria, and required provider support.
    </Paragraph>
</Container>