@using Blazorise.Docs.Models

<Div>
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">
            Choose your plan
        </Heading>
        <Lead TextColor="TextColor.Muted">
            Choose Indie for one eligible project, Professional for unlimited projects and dedicated support, or Enterprise for premium benefits.
        </Lead>
    </Div>

    <Card Class="b-pricing-controls" Border="Border.Rounded" Margin="Margin.Is5.FromBottom">
        <CardBody Padding="Padding.Is4">
            <Div Flex="Flex.Column.Row.OnDesktop.JustifyContent.Center.AlignItems.Center" Gap="Gap.Is4">
                <Div Flex="Flex.Column.AlignItems.Center" Gap="Gap.Is2">
                    <Strong>Professional &amp; Enterprise billing</Strong>
                    <PlanSwitch SelectedValue="@Plan" SelectedValueChanged="@PlanChanged" />
                </Div>
                <Div Flex="Flex.Column.AlignItems.Center" Gap="Gap.Is2">
                    <Strong>Number of developers</Strong>
                    <DevelopersPicker Value="@Quantity" ValueChanged="@QuantityChanged" />
                </Div>
            </Div>
            <Paragraph TextColor="TextColor.Muted" TextSize="TextSize.Small" TextAlignment="TextAlignment.Center" Margin="Margin.Is3.FromTop.Is0.FromBottom">
                These controls apply to Professional and Enterprise. Their prices are totals for @Quantity @DevLabel. Indie is always billed annually for one registered project.
            </Paragraph>
        </CardBody>
    </Card>

    <Row Class="b-pricing-plan-grid" Margin="Margin.Is3.FromBottom" Gutter="Gutter.Is3">
        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet.Is3.OnWidescreen" Margin="Margin.Is4.FromBottom">
            <PricingCard PlanName="Indie" PlanDescription="For solo developers building their own product." Quantity="1" QuantityUnit="project" PlanPrice="@CommercialPriceList.IndieAnnual.Price" ReferencePrice="@CommercialPriceList.IndieAnnual" PlanUnit="year" BillingNote="Billed annually only" CurrencySymbol="€" CurrencyCode="EUR" ShowPlan TextAccentColor="TextColor.Default">
                <ButtonContent>
                    <PurchaseButton Color="Color.Primary" ProductId="@PaddlePrices.IndieYearlySubscriptionPerProject" Quantity="1" ProductName="Blazorise Indie">
                        Buy Indie
                    </PurchaseButton>
                </ButtonContent>
                <IncludesContent>
                    Includes
                </IncludesContent>
                <ChildContent>
                    <UnorderedList Unstyled Margin="Margin.Is0.FromBottom">
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            <Anchor To="https://github.com/Megabit/Blazorise" Title="Link to GitHub">90+ Core UI Components</Anchor>
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Commercial use for one registered project
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Full component usage
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            License banner removed
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            <Anchor To="https://github.com/Megabit/Blazorise/issues">Community support</Anchor>
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Regular updates
                        </UnorderedListItem>
                    </UnorderedList>
                    <Paragraph TextSize="TextSize.Small" TextColor="TextColor.Muted" Margin="Margin.Is3.FromTop.Is0.FromBottom">
                        For independently owned projects earning below €25,000/year.
                        <Anchor To="indie">View Indie eligibility</Anchor>
                    </Paragraph>
                </ChildContent>
            </PricingCard>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet.Is3.OnWidescreen" Margin="Margin.Is4.FromBottom">
            <PricingCard PlanName="Professional" PlanDescription="Product support for commercial applications." Quantity="@Quantity" PlanPrice="@ProfessionalPrices[Plan].Price" ReferencePrice="@ProfessionalPrices[Plan]" PlanUnit="@ProfessionalPrices[Plan].Unit" ShowPlan ShowHigherPlan="@(Plan == "annually")" CurrencySymbol="@ProfessionalPrices[Plan].CurrencySymbol" CurrencyCode="@ProfessionalPrices[Plan].CurrencyCode" ShowDiscount TextAccentColor="TextColor.Default">
                <ButtonContent>
                    <PurchaseButton Color="Color.Primary" ProductId="@ProfessionalPrices[Plan].ProductId" Quantity="@Quantity" ProductName="Blazorise Professional">
                        Buy Professional
                    </PurchaseButton>
                </ButtonContent>
                <IncludesContent>
                    Everything in Indie
                </IncludesContent>
                <ChildContent>
                    <UnorderedList Unstyled Margin="Margin.Is0.FromBottom">
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Unlimited projects per licensed developer
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Business, client, and agency use
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            No project revenue limit
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            <Anchor To="https://blazorise.com/support">Premium forum support</Anchor>
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Dedicated customer support
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            24-hour response time
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            License management dashboard for teams
                        </UnorderedListItem>
                    </UnorderedList>
                </ChildContent>
            </PricingCard>
        </Column>

        <Column Class="b-background-glow-host" ColumnSize="ColumnSize.Is12.Is6.OnTablet.Is3.OnWidescreen" Margin="Margin.Is4.FromBottom">
            <BackgroundGlow Variant="BackgroundGlowVariant.Halo" Spread="clamp(32px, 4vw, 56px)" Intensity="0.28" DarkIntensity="0.20" />
            <PricingCard PlanName="Enterprise" PlanDescription="More tools and priority support for your team." Quantity="@Quantity" PlanPrice="@EnterprisePrices[Plan].Price" ReferencePrice="@EnterprisePrices[Plan]" PlanUnit="@EnterprisePrices[Plan].Unit" ShowPlan ShowHigherPlan="@(Plan == "annually")" CurrencySymbol="@EnterprisePrices[Plan].CurrencySymbol" CurrencyCode="@EnterprisePrices[Plan].CurrencyCode" ShowDiscount TextAccentColor="TextColor.Primary">
                <ButtonContent>
                    <PurchaseButton Color="Color.Primary" ProductId="@EnterprisePrices[Plan].ProductId" Quantity="@Quantity" ProductName="Blazorise Enterprise">
                        Buy Enterprise
                    </PurchaseButton>
                </ButtonContent>
                <IncludesContent>
                    Everything in Professional
                </IncludesContent>
                <ChildContent>
                    <UnorderedList Unstyled Margin="Margin.Is0.FromBottom">
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            <Span>Access to</Span>
                            <Anchor To="themes" Title="Link to themes page">
                                Premium themes
                            </Anchor>
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            <Span>Access to</Span>
                            <Anchor To="blocks" Title="Link to blocks page">
                                Blazorise Blocks
                            </Anchor>
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Priority customer support
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            16-hour response time
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Bug-fix prioritization
                        </UnorderedListItem>
                    </UnorderedList>
                </ChildContent>
            </PricingCard>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet.Is3.OnWidescreen" Margin="Margin.Is4.FromBottom">
            <PricingCard PlanName="Enterprise Plus" PlanDescription="A closer partnership with the Blazorise team." PlanPrice="decimal.MinusOne" ShowPlan>
                <ButtonContent>
                    <Button Type="ButtonType.Link" To="contact" Color="Color.Primary" Size="Size.Large" Outline Block>
                        Contact sales
                    </Button>
                </ButtonContent>
                <IncludesContent>
                    Everything in Enterprise
                </IncludesContent>
                <ChildContent>
                    <UnorderedList Unstyled Margin="Margin.Is0.FromBottom">
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Unlimited support tickets
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            <Anchor To="enterprise-plus" Title="Link to enterprise plus page">Expert on Demand</Anchor>, the Blazorise team helping you hands-on (30 hours)
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Priority scheduling for new features
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Legal indemnification
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Escrow
                        </UnorderedListItem>
                        <UnorderedListItem Padding="Padding.Is2.OnY">
                            <Icon TextColor="TextColor.Primary" Padding="Padding.Is2.FromEnd" Name="IconName.Check" IconSize="IconSize.Small" />
                            Customized agreement
                        </UnorderedListItem>
                    </UnorderedList>
                </ChildContent>
            </PricingCard>
        </Column>
    </Row>

    <Paragraph TextColor="TextColor.Muted" TextSize="TextSize.Small" TextAlignment="TextAlignment.Center" Margin="Margin.Is3.FromTop.Is0.FromBottom">
        Prices are in EUR, excluding VAT. Indie is billed annually per project; Professional and Enterprise are billed per developer. Applicable taxes are calculated at checkout.
    </Paragraph>
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromTop">
        <Anchor To="/pricing#compare-plans">Compare all features and support limits</Anchor>
    </Div>
</Div>