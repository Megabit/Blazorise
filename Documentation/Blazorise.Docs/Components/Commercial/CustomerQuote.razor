<article class="b-customer-story">
    <Div Class="b-customer-story-identity">
        <Div Class="b-customer-story-logo">
            <Image Source="@LogoUrl" Text="@LogoText" Loading />
        </Div>
        <Heading Size="HeadingSize.Is2">@LogoText</Heading>
        <Anchor To="@PartnerUrl">Visit @LogoText <Span aria-hidden="true">&#8599;</Span></Anchor>
    </Div>
    <blockquote class="b-customer-story-quote">
        <Paragraph>@Quote</Paragraph>
    </blockquote>
</article>

@code {
    [Parameter] public string LogoUrl { get; set; }
    [Parameter] public string LogoText { get; set; }
    [Parameter] public string Quote { get; set; }
    [Parameter] public string PartnerUrl { get; set; }
}