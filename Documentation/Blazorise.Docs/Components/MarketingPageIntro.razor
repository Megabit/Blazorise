<header class="@( Centered ? "b-page-intro b-page-intro--centered" : "b-page-intro" )">
    <Div Class="b-visual-container">
        <Div Class="b-page-intro__content">
            <Div Class="b-page-intro__heading">
                <Heading Size="HeadingSize.Is1">@Title</Heading>
            </Div>
            <Div Class="b-page-intro__detail">
                <Paragraph Class="b-page-intro__description">@Description</Paragraph>
                @if ( Actions is not null )
                {
                    <Div Class="b-page-intro__actions">@Actions</Div>
                }
            </Div>
        </Div>
    </Div>
</header>

@code {
    [Parameter] public RenderFragment Title { get; set; }
    [Parameter] public RenderFragment Description { get; set; }
    [Parameter] public RenderFragment Actions { get; set; }
    [Parameter] public bool Centered { get; set; }
}