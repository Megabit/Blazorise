                        <TopMenuStart />
                    </BarStart>
                    <BarEnd>
                        <TopMenuEnd />
                    </BarEnd>
                </BarMenu>
            </Bar>
        </LayoutHeader>
        <CascadingValue Value="@this" IsFixed>
            <LayoutContent Padding="Padding.Is0.OnX.Is4.OnY.Is4.OnWidescreen">
                <Container Breakpoint="Breakpoint.Widescreen">
                    <DocsTocContext>
                        <Row>
                            <Column ColumnSize="ColumnSize.Is12.Is10.OnDesktop" Class="b-docs-page">
                                @if ( isRouterTabsExample )
                                {
                                    <RouterTabs />
                                }
                                else
                                {
                                    @Body
                                }
                            </Column>
                            <Column ColumnSize="ColumnSize.Is2.OnDesktop">
                                <Toc />
                            </Column>
                        </Row>
                    </DocsTocContext>
                </Container>
            </LayoutContent>
        </CascadingValue>
    </Layout>
</Layout>
@code {
    RenderFragment customIcon = @<Image Source="/img/logos/blazorise-small.svg" Text="Small Blazorise logo" Width="Width.Px( 32 )" Height="Height.Px( 32 )" />;

    private RenderFragment RenderSidebarLabel( string route, string text, bool isGroup = false ) => __builder =>
    {
        var badges = ResolveSidebarBadges( route, isGroup );

        if ( badges.IsNew )
        {
            <Span Display="Display.Flex" Flex="Flex.JustifyContent.Between" Width="Width.Is100">
                <DocsNewFeatureBadge>@text</DocsNewFeatureBadge>
            </Span>
        }
        else if ( badges.IsUpdated )
        {
            <Span Display="Display.Flex" Flex="Flex.JustifyContent.Between" Width="Width.Is100">
                <DocsUpdatedFeatureBadge>@text</DocsUpdatedFeatureBadge>
            </Span>
        }
        else
        {
            <text>@text</text>
        }
    };
}