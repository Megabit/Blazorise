@page "/education"

<Seo Canonical="/education"
     Title="Blazorise Education | Courses, student and classroom licenses"
     Description="Explore practical C#, Blazor, and Blazorise courses, free educational licenses for eligible students and teachers, and bulk classroom licenses for institutions." />

<PageHeader>
    <Title>
        Blazorise Education
    </Title>
    <Subtitle>
        Build real-world apps with professional Blazor tools
    </Subtitle>
    <Description>
        Learn C#, Blazor, and Blazorise with practical courses. Explore free educational licenses for eligible students and teachers, and classroom access for institutions.
    </Description>
    <Actions>
        <Div Flex="Flex.Column" Gap="Gap.Is4">
            <Div Flex="Flex.Column.Row.OnDesktop.JustifyContent.Center" Gap="Gap.Is3">
                <Button Type="ButtonType.Link" To="/support/education/apply?type=student" Color="Color.Primary" Size="Size.Large" Padding="Padding.Is4.OnX">
                    <Icon Name="IconName.User" />
                    Apply as a student
                </Button>
                <Button Type="ButtonType.Link" To="/support/education/apply?type=teacher" Color="Color.Secondary" Size="Size.Large" Padding="Padding.Is4.OnX">
                    <Icon Name="IconName.Users" />
                    Apply as a teacher
                </Button>
            </Div>
            <Div Flex="Flex.Column.Row.OnTablet.JustifyContent.Center" Gap="Gap.Is3">
                <Anchor To="/education#courses">Courses</Anchor>
                <Anchor To="/education#individual-licenses">Individual licenses</Anchor>
                <Anchor To="/education#classroom-licenses">Classroom Licenses</Anchor>
            </Div>
        </Div>
    </Actions>
</PageHeader>

<Container ElementId="individual-licenses" Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
            Free individual licenses for students and teachers
        </Heading>
        <Lead TextColor="TextColor.Muted">
            Use Blazorise Professional or Enterprise components for coursework, teaching, and non-commercial academic research. Choose the license that matches your role.
        </Lead>
    </Div>

    <Div Flex="Flex.Column.Row.OnTablet.JustifyContent.Center" Gap="Gap.Is4" TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
        <Span><Icon Name="IconName.CheckCircle" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Free for eligible students and teachers</Span>
        <Span><Icon Name="IconName.CalendarWeek" TextColor="TextColor.Primary" Margin="Margin.Is2.FromEnd" />Valid for one year</Span>
        <Span><Icon Name="IconName.ShieldAlt" TextColor="TextColor.Info" Margin="Margin.Is2.FromEnd" />Renewable after re-verification</Span>
    </Div>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody Padding="Padding.Is4.Is5.OnDesktop" Display="Display.Flex" Flex="Flex.Column">
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Start" Margin="Margin.Is4.FromBottom">
                        <Div>
                            <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is2.FromBottom">For students</Paragraph>
                            <Heading Size="HeadingSize.Is3" TextWeight="TextWeight.SemiBold">Student license</Heading>
                        </Div>
                        <Icon Name="IconName.User" IconSize="IconSize.x2" TextColor="TextColor.Primary" />
                    </Div>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        Build coursework and portfolio projects, and carry out academic research with professional Blazor components.
                    </Paragraph>
                    <Heading Size="HeadingSize.Is4" TextSize="TextSize.Heading5">Who can apply</Heading>
                    <Div Flex="Flex.Column" Gap="Gap.Is2" Margin="Margin.Is4.FromBottom">
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Currently enrolled students</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />A verified university email address</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Non-commercial educational use</Span>
                    </Div>
                    <Heading Size="HeadingSize.Is4" TextSize="TextSize.Heading5">Verification options</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        A university email is required for every method. You may also provide an ISIC card number, official academic documents, or authorization through an existing GitHub Student Developer Pack.
                    </Paragraph>
                    <Div Margin="Margin.IsAuto.FromTop">
                        <Button Type="ButtonType.Link" To="/support/education/apply?type=student" Color="Color.Primary" Size="Size.Large">
                            Apply as a student
                        </Button>
                    </Div>
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody Padding="Padding.Is4.Is5.OnDesktop" Display="Display.Flex" Flex="Flex.Column">
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Start" Margin="Margin.Is4.FromBottom">
                        <Div>
                            <Paragraph TextColor="TextColor.Info" TextWeight="TextWeight.Bold" Margin="Margin.Is2.FromBottom">For teachers</Paragraph>
                            <Heading Size="HeadingSize.Is3" TextWeight="TextWeight.SemiBold">Teacher license</Heading>
                        </Div>
                        <Icon Name="IconName.Users" IconSize="IconSize.x2" TextColor="TextColor.Info" />
                    </Div>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        An individual license for your teaching preparation, classroom demonstrations, and academic work.
                    </Paragraph>
                    <Heading Size="HeadingSize.Is4" TextSize="TextSize.Heading5">Who can apply</Heading>
                    <Div Flex="Flex.Column" Gap="Gap.Is2" Margin="Margin.Is4.FromBottom">
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Active teachers at eligible institutions</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />A verified university email address</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Non-commercial teaching and academic use</Span>
                    </Div>
                    <Heading Size="HeadingSize.Is4" TextSize="TextSize.Heading5">Verification options</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        A university email is required for every method. You may also provide an ITIC card number or official documents confirming your academic employment.
                    </Paragraph>
                    <Div Margin="Margin.IsAuto.FromTop">
                        <Button Type="ButtonType.Link" To="/support/education/apply?type=teacher" Color="Color.Primary" Size="Size.Large">
                            Apply as a teacher
                        </Button>
                    </Div>
                </CardBody>
            </Card>
        </Column>
    </Row>
</Container>

<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">How to get your individual educational license</Heading>
        <Lead TextColor="TextColor.Muted">Choose your role, verify your eligibility, and activate your license.</Lead>
    </Div>
    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Div TextAlignment="TextAlignment.Center" Padding="Padding.Is3">
                <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 1</Paragraph>
                <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Choose your role</Heading>
                <Paragraph TextColor="TextColor.Muted">
                    Start a student or teacher application and tell us about your educational status.
                </Paragraph>
            </Div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Div TextAlignment="TextAlignment.Center" Padding="Padding.Is3">
                <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 2</Paragraph>
                <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Verify eligibility</Heading>
                <Paragraph TextColor="TextColor.Muted">
                    Verify your university email and provide the evidence required for your selected method.
                </Paragraph>
            </Div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Div TextAlignment="TextAlignment.Center" Padding="Padding.Is3">
                <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 3</Paragraph>
                <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Activate your license</Heading>
                <Paragraph TextColor="TextColor.Muted">
                    Once approved, find your educational license in your Blazorise account and start building.
                </Paragraph>
            </Div>
        </Column>
    </Row>
</Container>

<Container ElementId="courses" Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
            Learn C#, Blazor, and Blazorise at your own pace
        </Heading>
        <Lead TextColor="TextColor.Muted">
            Courses are for everyone interested in building with .NET. Browse the public catalog and explore what each course covers before signing in.
        </Lead>
    </Div>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.BookReader" IconSize="IconSize.x2" TextColor="TextColor.Primary" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Browse before signing in</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Preview learning outcomes, prerequisites, modules, lesson titles, difficulty, and estimated duration without an account.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.Code" IconSize="IconSize.x2" TextColor="TextColor.Success" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Learn by doing</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Sign in with a Blazorise account that has course access to start learning through practical exercises and assessments.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.CheckCircle" IconSize="IconSize.x2" TextColor="TextColor.Info" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Track your progress</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        When signed in, track your progress through lessons, exercises, and assessments.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
    </Row>

    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is3.FromTop">
        <Button Type="ButtonType.Link" To="https://blazorise.com/support/courses" Color="Color.Primary" Size="Size.Large">
            Explore courses
        </Button>
    </Div>
</Container>

<Container ElementId="classroom-licenses" Padding="Padding.Is5.OnY">
    <Card Border="Border.Rounded" Shadow="Shadow.Small">
        <CardBody Padding="Padding.Is4.Is5.OnDesktop">
            <Row Flex="Flex.AlignItems.Center">
                <Column ColumnSize="ColumnSize.Is12">
                    <Paragraph TextColor="TextColor.Info" TextWeight="TextWeight.Bold" Margin="Margin.Is2.FromBottom">For educators and institutions</Paragraph>
                    <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Classroom Licenses for institutions</Heading>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        Request educational licenses in bulk for your university, school, or training program. Once approved, your institution receives a defined number of seats. Administrators invite students, assign seats, and manage access centrally.
                    </Paragraph>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>One institutional application for a group of students</Span>
                            </Div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>Let administrators invite students and assign seats</Span>
                            </Div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>Give students educational benefits and guided course access</Span>
                            </Div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>Manage classroom access centrally</Span>
                            </Div>
                        </Column>
                    </Row>
                </Column>
                <Column ColumnSize="ColumnSize.Is12" Margin="Margin.Is3.FromTop">
                    <Button Type="ButtonType.Link" To="https://blazorise.com/support/education/classroom/apply" Color="Color.Primary" Size="Size.Large" TextOverflow="TextOverflow.Wrap">
                        Apply for a Classroom License
                    </Button>
                </Column>
            </Row>
        </CardBody>
    </Card>
</Container>

<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Frequently asked questions</Heading>
        <Lead TextColor="TextColor.Muted">Answers about courses, individual licenses, and institutional access.</Lead>
    </Div>
    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop" Margin="Margin.IsAuto.OnX">
            <Accordion>
                <AccordionItem @bind-Visible="IsLicenseIncludedVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>What is included with an individual educational license?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        Approved students and teachers receive a free Blazorise Professional or Enterprise license for non-commercial learning, teaching, coursework, and academic research.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsCommercialUseVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>Can I use the license for commercial work?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        No. Educational Licenses are for non-commercial educational activity only. They cannot be shared, transferred, resold, or used to provide paid commercial services.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsVerificationVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>Do individual applicants need a university email?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        Yes. Every individual student or teacher application requires a verified university email address. Depending on your role and verification method, you may also provide an ISIC or ITIC card number, official academic documents, or GitHub Student Developer Pack authorization.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsRenewalVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>How long does an individual license last?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        An individual educational license is valid for one year. You can apply to renew it while you remain eligible, and you will be asked to verify your educational status again.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsReviewVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>How long does individual license approval take?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        Email and GitHub Student Developer Pack verification may be handled quickly. Applications using card numbers or official documents require manual review and can take longer. We will email you if a reviewer needs more information.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsCourseAccessVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>Can I explore courses without an educational license?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        Yes. Anyone can browse the course catalog and preview learning outcomes, prerequisites, modules, lesson titles, difficulty, and estimated duration without signing in. Starting a course, completing exercises and assessments, and tracking progress require signing in with an account that has course access. Students assigned a Classroom License receive access to the guided course platform.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsClassroomLicenseVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>Should I apply for a teacher license or a Classroom License?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        Choose an individual teacher license for your own teaching preparation, demonstrations, and academic work. Choose a Classroom License if you represent an institution and need educational licenses for a group of students. After approval, your institution's administrators can invite students, assign seats, and manage classroom access centrally. A teacher's individual license does not provide licenses for their students.
                    </AccordionBody>
                </AccordionItem>
            </Accordion>
            <Paragraph TextAlignment="TextAlignment.Center" TextColor="TextColor.Muted" Margin="Margin.Is4.FromTop">
                Review the complete <Anchor To="terms">Terms of Service</Anchor> before applying.
            </Paragraph>
        </Column>
    </Row>
</Container>

@code {
    private bool IsLicenseIncludedVisible { get; set; } = true;

    private bool IsCommercialUseVisible { get; set; }

    private bool IsVerificationVisible { get; set; }

    private bool IsRenewalVisible { get; set; }

    private bool IsReviewVisible { get; set; }

    private bool IsCourseAccessVisible { get; set; }

    private bool IsClassroomLicenseVisible { get; set; }
}