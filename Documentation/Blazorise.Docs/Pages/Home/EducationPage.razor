@page "/education"

<Seo Canonical="/education"
     Title="Blazorise Education Program | Free licenses for students and teachers"
     Description="Eligible students and teachers can apply for a free Blazorise Professional or Enterprise educational license for non-commercial learning, teaching, and academic research." />

<PageHeader>
    <Title>
        Blazorise Education
    </Title>
    <Subtitle>
        Build real-world apps with professional Blazor tools
    </Subtitle>
    <Description>
        Free Professional or Enterprise access for eligible students and teachers learning, teaching, and researching with Blazor.
    </Description>
    <Actions>
        <Button Type="ButtonType.Link" To="/support/education/apply?type=student" Color="Color.Primary" Size="Size.Large" Padding="Padding.Is4.OnX">
            <Icon Name="IconName.User" />
            Apply as a student
        </Button>
        <Button Type="ButtonType.Link" To="/support/education/apply?type=teacher" Color="Color.Secondary" Size="Size.Large" Padding="Padding.Is4.OnX">
            <Icon Name="IconName.Users" />
            Apply as a teacher
        </Button>
    </Actions>
</PageHeader>

<Container Padding="Padding.Is5.OnY">
    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is3.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.CheckCircle" IconSize="IconSize.x2" TextColor="TextColor.Success" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">No cost for eligible applicants</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Eligible students and teachers receive access to the education program at no charge.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is3.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.CalendarWeek" IconSize="IconSize.x2" TextColor="TextColor.Primary" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Valid for one year</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Each Educational License remains active for one year from the date it is issued.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is3.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.ShieldAlt" IconSize="IconSize.x2" TextColor="TextColor.Info" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Renewable after re-verification</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Apply to renew while you remain eligible and verify your educational status again.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
    </Row>
</Container>

<Container Padding="Padding.Is5.OnY">
    <Row Flex="Flex.AlignItems.Center">
        <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop" Margin="Margin.Is4.FromBottom.OnMobile">
            <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
                Learn and teach with the complete Blazorise experience
            </Heading>
            <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted">
                Move beyond basic components and use the same UI framework capabilities available to professional development teams.
            </Paragraph>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
            <Row>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                    <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                        <CardBody>
                            <Icon Name="IconName.Code" IconSize="IconSize.x2" TextColor="TextColor.Primary" Margin="Margin.Is3.FromBottom" />
                            <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Professional components</Heading>
                            <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                                Build polished web applications with the full component library and supported integrations.
                            </Paragraph>
                        </CardBody>
                    </Card>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                    <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                        <CardBody>
                            <Icon Name="IconName.Laptop" IconSize="IconSize.x2" TextColor="TextColor.Info" Margin="Margin.Is3.FromBottom" />
                            <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Production-ready skills</Heading>
                            <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                                Practice with tools and patterns that transfer directly to modern .NET development work.
                            </Paragraph>
                        </CardBody>
                    </Card>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom.OnMobile">
                    <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                        <CardBody>
                            <Icon Name="IconName.Users" IconSize="IconSize.x2" TextColor="TextColor.Success" Margin="Margin.Is3.FromBottom" />
                            <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">For study and teaching</Heading>
                            <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                                Use Blazorise for coursework, personal learning, lectures, labs, and academic research.
                            </Paragraph>
                        </CardBody>
                    </Card>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet">
                    <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                        <CardBody>
                            <Icon Name="IconName.CalendarWeek" IconSize="IconSize.x2" TextColor="TextColor.Warning" Margin="Margin.Is3.FromBottom" />
                            <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Access that grows with you</Heading>
                            <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                                Licenses last one year and can be renewed while your educational eligibility continues.
                            </Paragraph>
                        </CardBody>
                    </Card>
                </Column>
            </Row>
        </Column>
    </Row>
</Container>

<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
            One education program for students and teachers
        </Heading>
        <Lead TextColor="TextColor.Muted">
            Both paths provide professional Blazorise access. Choose the role that reflects your current academic status.
        </Lead>
    </Div>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody Padding="Padding.Is5">
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Start" Margin="Margin.Is4.FromBottom">
                        <Div>
                            <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is2.FromBottom">For students</Paragraph>
                            <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Student license</Heading>
                        </Div>
                        <Icon Name="IconName.User" IconSize="IconSize.x2" TextColor="TextColor.Primary" />
                    </Div>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        Build coursework, portfolio projects, and academic research with the full Blazorise toolkit.
                    </Paragraph>
                    <Heading Size="HeadingSize.Is5">Who can apply</Heading>
                    <Div Flex="Flex.Column" Gap="Gap.Is2" Margin="Margin.Is4.FromBottom">
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Currently enrolled students</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />A verified university email address</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Non-commercial educational use</Span>
                    </Div>
                    <Heading Size="HeadingSize.Is5">Verification options</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        A university email is required for every method. You may also provide an ISIC card number, official academic documents, or authorization through an existing GitHub Student Developer Pack.
                    </Paragraph>
                    <Button Type="ButtonType.Link" To="/support/education/apply?type=student" Color="Color.Primary" Size="Size.Large">
                        Apply as a student
                    </Button>
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody Padding="Padding.Is5">
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Start" Margin="Margin.Is4.FromBottom">
                        <Div>
                            <Paragraph TextColor="TextColor.Info" TextWeight="TextWeight.Bold" Margin="Margin.Is2.FromBottom">For teachers</Paragraph>
                            <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Teacher license</Heading>
                        </Div>
                        <Icon Name="IconName.Users" IconSize="IconSize.x2" TextColor="TextColor.Info" />
                    </Div>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        Prepare lessons, demonstrate production UI patterns, and support practical learning in the classroom.
                    </Paragraph>
                    <Heading Size="HeadingSize.Is5">Who can apply</Heading>
                    <Div Flex="Flex.Column" Gap="Gap.Is2" Margin="Margin.Is4.FromBottom">
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Active teachers at eligible institutions</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />A verified university email address</Span>
                        <Span><Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is2.FromEnd" />Non-commercial teaching and academic use</Span>
                    </Div>
                    <Heading Size="HeadingSize.Is5">Verification options</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        A university email is required for every method. You may also provide an ITIC card number or official documents confirming your academic employment.
                    </Paragraph>
                    <Button Type="ButtonType.Link" To="/support/education/apply?type=teacher" Color="Color.Primary" Size="Size.Large">
                        Apply as a teacher
                    </Button>
                </CardBody>
            </Card>
        </Column>
    </Row>
</Container>

<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Get started in three steps</Heading>
        <Lead TextColor="TextColor.Muted">Choose your role, verify your eligibility, and activate your license.</Lead>
    </Div>
    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody TextAlignment="TextAlignment.Center">
                    <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 1</Paragraph>
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Choose your role</Heading>
                    <Paragraph TextColor="TextColor.Muted">
                        Start a student or teacher application and tell us about your educational status.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody TextAlignment="TextAlignment.Center">
                    <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 2</Paragraph>
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Verify eligibility</Heading>
                    <Paragraph TextColor="TextColor.Muted">
                        Verify your university email and provide the evidence required for your selected method.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody TextAlignment="TextAlignment.Center">
                    <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 3</Paragraph>
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Activate your license</Heading>
                    <Paragraph TextColor="TextColor.Muted">
                        Once approved, access your Educational License from your Blazorise Account and start building.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
    </Row>
</Container>

<Container Padding="Padding.Is5.OnY">
    <Card Border="Border.Rounded" Shadow="Shadow.Small">
        <CardBody Padding="Padding.Is5">
            <Row Flex="Flex.AlignItems.Center">
                <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                    <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Ready to bring professional Blazor development into your education?</Heading>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Apply with your university email and choose the verification method that works best for you.
                    </Paragraph>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop" TextAlignment="TextAlignment.End" Margin="Margin.Is4.FromTop.OnMobile">
                    <Div Flex="Flex.Column.Row.OnDesktop.JustifyContent.End" Gap="Gap.Is2">
                        <Button Type="ButtonType.Link" To="/support/education/apply?type=student" Color="Color.Primary" Size="Size.Large">Student application</Button>
                        <Button Type="ButtonType.Link" To="/support/education/apply?type=teacher" Color="Color.Light" Size="Size.Large">Teacher application</Button>
                    </Div>
                </Column>
            </Row>
        </CardBody>
    </Card>
</Container>

<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Frequently asked questions</Heading>
        <Lead TextColor="TextColor.Muted">Everything you need to know before applying.</Lead>
    </Div>
    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop" Margin="Margin.IsAuto.OnX">
            <Accordion>
                <AccordionItem @bind-Visible="IsLicenseIncludedVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>What is included with an Educational License?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        Approved applicants receive the Professional or Enterprise product configured for the education program, with access intended for learning, teaching, coursework, and academic research.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsCommercialUseVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>Can I use the license for commercial work?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        No. Educational Licenses are for non-commercial educational activity only. They cannot be shared, transferred, resold, or used to provide paid commercial services.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsVerificationVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>Why is a university email required?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        A verified university email is required for every application. Depending on the verification method, we may also request an ISIC or ITIC card number, official documents, or GitHub Student Developer Pack authorization.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsRenewalVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>How long does the license last?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        An Educational License is valid for one year. You can apply to renew it while you remain eligible, and you will be asked to verify your educational status again.
                    </AccordionBody>
                </AccordionItem>
                <AccordionItem @bind-Visible="IsReviewVisible">
                    <AccordionHeader>
                        <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.Normal">
                            <AccordionToggle>How long does approval take?</AccordionToggle>
                        </Heading>
                    </AccordionHeader>
                    <AccordionBody>
                        Email and GitHub Student Developer Pack verification may be handled quickly. Applications using card numbers or official documents require manual review and can take longer. We will email you if a reviewer needs more information.
                    </AccordionBody>
                </AccordionItem>
            </Accordion>
            <Paragraph TextAlignment="TextAlignment.Center" TextColor="TextColor.Muted" Margin="Margin.Is4.FromTop">
                Review the complete <Anchor To="terms">Terms of Service</Anchor> before applying.
            </Paragraph>
        </Column>
    </Row>
</Container>

@code {
    private bool IsLicenseIncludedVisible { get; set; } = true;

    private bool IsCommercialUseVisible { get; set; }

    private bool IsVerificationVisible { get; set; }

    private bool IsRenewalVisible { get; set; }

    private bool IsReviewVisible { get; set; }
}