<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
            More ways to build and learn
        </Heading>
        <Lead TextColor="TextColor.Muted">
            Find a starting point for your next interface, develop your skills, or bring Blazorise into the classroom.
        </Lead>
    </Div>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody Padding="Padding.Is4" Display="Display.Flex" Flex="Flex.Column">
                    <Icon Name="IconName.LayerGroup" IconSize="IconSize.x2" TextColor="TextColor.Primary" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.SemiBold">Build with Blocks</Heading>
                    <Paragraph TextColor="TextColor.Muted">
                        Start with ready-made UI sections built with Blazorise components. Explore layouts you can adapt to your application.
                    </Paragraph>
                    <Div Margin="Margin.IsAuto.FromTop">
                        <Anchor To="blocks">Explore Blocks</Anchor>
                    </Div>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody Padding="Padding.Is4" Display="Display.Flex" Flex="Flex.Column">
                    <Icon Name="IconName.Book" IconSize="IconSize.x2" TextColor="TextColor.Info" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.SemiBold">Learn at your own pace</Heading>
                    <Paragraph TextColor="TextColor.Muted">
                        Explore practical C#, Blazor, and Blazorise courses. Previews are open to everyone; sign in with an eligible account to start learning and track your progress.
                    </Paragraph>
                    <Div Margin="Margin.IsAuto.FromTop">
                        <Anchor To="https://blazorise.com/support/courses">Explore courses</Anchor>
                    </Div>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody Padding="Padding.Is4" Display="Display.Flex" Flex="Flex.Column">
                    <Icon Name="IconName.Users" IconSize="IconSize.x2" TextColor="TextColor.Success" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is3" TextSize="TextSize.Heading4" TextWeight="TextWeight.SemiBold">Bring Blazorise to education</Heading>
                    <Paragraph TextColor="TextColor.Muted">
                        Explore free educational licenses for eligible students and teachers, or Classroom Licenses for institutions managing access for groups of learners.
                    </Paragraph>
                    <Div Margin="Margin.IsAuto.FromTop">
                        <Anchor To="education">Explore educational licenses</Anchor>
                    </Div>
                </CardBody>
            </Card>
        </Column>
    </Row>
</Container>