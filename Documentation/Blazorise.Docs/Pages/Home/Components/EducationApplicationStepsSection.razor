<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">How to get your individual educational license</Heading>
        <Lead TextColor="TextColor.Muted">Choose your role, verify your eligibility, and activate your license.</Lead>
    </Div>
    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Div TextAlignment="TextAlignment.Center" Padding="Padding.Is3">
                <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 1</Paragraph>
                <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Choose your role</Heading>
                <Paragraph TextColor="TextColor.Muted">
                    Start a student or teacher application and tell us about your educational status.
                </Paragraph>
            </Div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Div TextAlignment="TextAlignment.Center" Padding="Padding.Is3">
                <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 2</Paragraph>
                <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Verify eligibility</Heading>
                <Paragraph TextColor="TextColor.Muted">
                    Verify your university email and provide the evidence required for your selected method.
                </Paragraph>
            </Div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Div TextAlignment="TextAlignment.Center" Padding="Padding.Is3">
                <Paragraph TextColor="TextColor.Primary" TextWeight="TextWeight.Bold" Margin="Margin.Is3.FromBottom">Step 3</Paragraph>
                <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Activate your license</Heading>
                <Paragraph TextColor="TextColor.Muted">
                    Once approved, find your educational license in your Blazorise account and start building.
                </Paragraph>
            </Div>
        </Column>
    </Row>
</Container>