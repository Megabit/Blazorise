<Container ElementId="classroom-licenses" Padding="Padding.Is5.OnY">
    <Card Border="Border.Rounded" Shadow="Shadow.Small">
        <CardBody Padding="Padding.Is4.Is5.OnDesktop">
            <Row Flex="Flex.AlignItems.Center">
                <Column ColumnSize="ColumnSize.Is12">
                    <Paragraph TextColor="TextColor.Info" TextWeight="TextWeight.Bold" Margin="Margin.Is2.FromBottom">For educators and institutions</Paragraph>
                    <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">Classroom Licenses for institutions</Heading>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is4.FromBottom">
                        Request educational licenses in bulk for your university, school, or training program. Once approved, your institution receives a defined number of seats. Administrators invite students, assign seats, and manage access centrally.
                    </Paragraph>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>One institutional application for a group of students</Span>
                            </Div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>Let administrators invite students and assign seats</Span>
                            </Div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>Give students educational benefits and guided course access</Span>
                            </Div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet" Margin="Margin.Is3.FromBottom">
                            <Div Flex="Flex.AlignItems.Start" Gap="Gap.Is3">
                                <Icon Name="IconName.Check" TextColor="TextColor.Success" Margin="Margin.Is1.FromTop" />
                                <Span>Manage classroom access centrally</Span>
                            </Div>
                        </Column>
                    </Row>
                </Column>
                <Column ColumnSize="ColumnSize.Is12" Margin="Margin.Is3.FromTop">
                    <Button Type="ButtonType.Link" To="https://blazorise.com/support/education/classroom/apply" Color="Color.Primary" Size="Size.Large" TextOverflow="TextOverflow.Wrap">
                        Apply for a Classroom License
                    </Button>
                </Column>
            </Row>
        </CardBody>
    </Card>
</Container>