<Container ElementId="courses" Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
            Learn C#, Blazor, and Blazorise at your own pace
        </Heading>
        <Lead TextColor="TextColor.Muted">
            Courses are for everyone interested in building with .NET. Browse the public catalog and explore what each course covers before signing in.
        </Lead>
    </Div>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.BookReader" IconSize="IconSize.x2" TextColor="TextColor.Primary" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Browse before signing in</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Preview learning outcomes, prerequisites, modules, lesson titles, difficulty, and estimated duration without an account.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.Code" IconSize="IconSize.x2" TextColor="TextColor.Success" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Learn by doing</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Sign in with a Blazorise account that has course access to start learning through practical exercises and assessments.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is4.FromBottom">
            <Card Border="Border.Rounded" Shadow="Shadow.Small" Height="Height.Is100">
                <CardBody>
                    <Icon Name="IconName.CheckCircle" IconSize="IconSize.x2" TextColor="TextColor.Info" Margin="Margin.Is3.FromBottom" />
                    <Heading Size="HeadingSize.Is4" TextWeight="TextWeight.SemiBold">Track your progress</Heading>
                    <Paragraph TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        When signed in, track your progress through lessons, exercises, and assessments.
                    </Paragraph>
                </CardBody>
            </Card>
        </Column>
    </Row>

    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is3.FromTop">
        <Button Type="ButtonType.Link" To="https://blazorise.com/support/courses" Color="Color.Primary" Size="Size.Large">
            Explore courses
        </Button>
    </Div>
</Container>