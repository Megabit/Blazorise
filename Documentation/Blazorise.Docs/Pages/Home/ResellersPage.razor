@page "/resellers"

<Seo Canonical="/resellers" Title="Blazorise Authorized Resellers" Description="Blazorise has a global resellers that work in your local currency. Find a comprehensive reseller. List available here!" />

<Div Class="b-visual b-marketing b-expanded-page b-resellers-page">
    <MarketingPageHeader Variant="BrandBackdropVariant.OrbitRoutes">
        <Title>Buy locally.<br /><Span>Build globally.</Span></Title>
        <Description>Find an official Blazorise reseller and contact their team about purchasing in your region.</Description>
        <Actions><Anchor To="purchase-order" Class="b-visual-button b-visual-button-primary">Request a direct quote</Anchor><Anchor To="contact" Class="b-visual-button b-visual-button-outline">Contact Blazorise</Anchor></Actions>
    </MarketingPageHeader>

    <section class="b-visual-section">
        <ResellerDirectory />
    </section>
</Div>