@page "/help-us-improve"

<Seo Canonical="/help-us-improve" Title="Help us improve Blazorise" Description="Have an idea or suggestion? Contact us and help us to improve Blazorise documentation, pages, and code, by voicing your thoughts!" />

<Div Class="b-visual b-marketing b-expanded-page b-help-us-improve-page">
    <MarketingPageHeader Variant="BrandBackdropVariant.DotField" Compact>
        <Title>Help shape<br /><Span>what comes next.</Span></Title>
        <Description>Have an idea for our documentation, components, or website? We would love to hear your thoughts.</Description>
        <Actions><Anchor To="/help-us-improve#request-form" Class="b-visual-button b-visual-button--primary">Share feedback</Anchor></Actions>
    </MarketingPageHeader>

    <MarketingContactSection Title="Your experience matters." Description="Tell us what worked, what got in your way, or what you would like to see next. Contact details are optional, so you can share feedback anonymously." RelatedTo="contact" RelatedLabel="Ask a product question">
        <Card Shadow="Shadow.Large">
            <Form>
                <CardBody>
                    <Validations @ref="validationsRef" Mode="ValidationMode.Manual">
                        <Fields>
                            <Field ColumnSize="ColumnSize.IsHalf.OnDesktop">
                                <FieldLabel>First name</FieldLabel>
                                <FieldBody>
                                    <Addons>
                                        <Addon AddonType="AddonType.Start">
                                            <AddonLabel>
                                                <Icon Name="IconName.User" />
                                            </AddonLabel>
                                        </Addon>
                                        <Addon AddonType="AddonType.Body">
                                            <TextInput @bind-Value="@User.FirstName" name="firstName" Placeholder="First Name..." aria-label="First Name..." />
                                        </Addon>
                                    </Addons>
                                </FieldBody>
                            </Field>
                            <Field ColumnSize="ColumnSize.IsHalf.OnDesktop">
                                <FieldLabel>Last name</FieldLabel>
                                <FieldBody>
                                    <Addons>
                                        <Addon AddonType="AddonType.Start">
                                            <AddonLabel>
                                                <Icon Name="IconName.Book" />
                                            </AddonLabel>
                                        </Addon>
                                        <Addon AddonType="AddonType.Body">
                                            <TextInput @bind-Value="@User.LastName" name="lastName" Placeholder="Last Name..." aria-label="Last Name..." />
                                        </Addon>
                                    </Addons>
                                </FieldBody>
                            </Field>
                        </Fields>
                        <Field>
                            <FieldLabel>Email address</FieldLabel>
                            <FieldBody>
                                <Addons>
                                    <Addon AddonType="AddonType.Start">
                                        <AddonLabel>
                                            <Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.Envelope" />
                                        </AddonLabel>
                                    </Addon>
                                    <TextInput @bind-Value="@User.Email" name="email" Role="TextRole.Email" Placeholder="Email Here..." aria-label="Email Here..." />
                                </Addons>
                            </FieldBody>
                        </Field>
                        <Validation Validator="ValidationRule.IsNotEmpty">
                            <Field>
                                <FieldLabel RequiredIndicator>What would you like to let us know?</FieldLabel>
                                <FieldBody>
                                    <MemoInput @bind-Value="@MessageBody" name="message" Rows="6" />
                                </FieldBody>
                            </Field>
                        </Validation>
                        <Row>
                            <Column Padding="Padding.Is3.FromBottom">
                                <Help>
                                    You may remain anonymous when providing us with your suggestions. Providing your contact information is optional.
                                </Help>
                            </Column>
                        </Row>
                        <Row>
                            <Validation Validator="@CaptchaInput.ValidateRobot">
                                <Column ColumnSize="ColumnSize.IsHalf.OnDesktop">
                                    <CaptchaInput Class="b-contact-captcha" @bind-Value=NotARobot>
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </CaptchaInput>
                                </Column>
                            </Validation>
                            <Column ColumnSize="ColumnSize.IsHalf.OnDesktop">
                                <Button Clicked="@SendEmail" Color="Color.Primary" Float="Float.End">Send Message</Button>
                            </Column>
                        </Row>
                    </Validations>
                </CardBody>
            </Form>
        </Card>
    </MarketingContactSection>
</Div>