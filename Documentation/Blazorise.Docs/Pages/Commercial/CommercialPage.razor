@page "/commercial"

<Seo Canonical="/commercial" Title="Blazorise Commercial | Licensing, Support & Services" Description="Compare Blazorise commercial licensing and product support, explore optional expert services, and find purchasing options for your team." />

<Div Class="b-visual b-marketing b-commercial-page">
<MarketingPageHeader Dark="true" Variant="BrandBackdropVariant.GeometricStack">
    <Title>Build with<br /><Span>confidence.</Span></Title>
    <Description>Get help from the people behind Blazorise. Choose commercial licensing and product support, with optional hands-on expertise for integration, training, and custom development. Battle-tested since 2018 and actively maintained for what comes next.</Description>
    <Actions>
        <Anchor To="pricing" Class="b-visual-button b-visual-button--primary">View pricing <Span aria-hidden="true">↗</Span></Anchor>
        <Anchor To="book-a-demo" Class="b-visual-button b-visual-button--outline">Book a demo</Anchor>
    </Actions>
</MarketingPageHeader>

<section class="b-visual-section b-commercial-licensing">
    <CommercialLicensingSection />
</section>

<section class="b-visual-section b-visual-trust">
<Container Padding="Padding.Is5.OnY">
    <Div TextAlignment="TextAlignment.Center" Margin="Margin.Is4.FromBottom">
        <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
            Trusted by teams building with Blazor
        </Heading>
        <Lead TextColor="TextColor.Muted">
            From internal tools to customer-facing products, teams use Blazorise as the foundation for their application UI.
        </Lead>
    </Div>
    <HomeClientLogos />
</Container>
</section>

<section class="b-visual-section b-marketing-dark b-commercial-services b-visual-landscape">
    <Div Class="b-visual-landscape__art" aria-hidden="true">
        <BrandBackdrop Variant="BrandBackdropVariant.LayeredPeaks" Dark Density="BrandBackdropDensity.Low" Primary="#542278" Secondary="#923760" Accent="#795393" />
    </Div>
    <CommercialServicesSection />
</section>

<section class="b-visual-section b-marketing-buying">
    <CommercialBuyingSection />
</section>

<section class="b-visual-section b-marketing-contact">
<Container Padding="Padding.Is5.OnY">
    <Card Border="Border.Rounded" Shadow="Shadow.Small">
        <CardBody Padding="Padding.Is4.Is5.OnDesktop">
            <Row Flex="Flex.AlignItems.Center">
                <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop" Margin="Margin.Is4.FromBottom.Is0.FromBottom.OnDesktop">
                    <Heading Size="HeadingSize.Is2" TextWeight="TextWeight.Bold">
                        Let's find the right fit for your team
                    </Heading>
                    <Paragraph TextSize="TextSize.Large" TextColor="TextColor.Muted" Margin="Margin.Is0.FromBottom">
                        Tell us about your project, developer count, and support needs. We can help you choose a plan or scope an expert engagement.
                    </Paragraph>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
                    <Div Flex="Flex.Column" Gap="Gap.Is3">
                        <Button Type="ButtonType.Link" To="contact" Color="Color.Primary" Size="Size.Large">
                            Contact sales
                        </Button>
                        <Anchor To="book-a-demo" TextAlignment="TextAlignment.Center">
                            Prefer a walkthrough? Book a demo
                        </Anchor>
                    </Div>
                </Column>
            </Row>
        </CardBody>
    </Card>
</Container>
</section>
</Div>