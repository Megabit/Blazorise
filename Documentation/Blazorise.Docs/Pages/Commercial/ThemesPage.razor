@page "/themes"

<Seo Canonical="/themes" Title="Blazorise Themes" Description="Blazorise Themes is a collection of the best templates and themes curated by Blazorise's creators. Our collection of templates include themes to build an admin, dashboard, landing page, e-commerce site, application, and more.." />

<Div Class="b-visual b-marketing b-expanded-page b-themes-page">
    <MarketingPageHeader Variant="BrandBackdropVariant.ColorBlocks">
        <Title>A head start.<br /><Span>Your own finish.</Span></Title>
        <Description>Professional, modern UI themes built by the Blazorise creators. Start with an existing design and make it your own.</Description>
        <Actions>
            <Anchor To="themes/blazestack" Class="b-visual-button b-visual-button-primary">Explore BlazeStack</Anchor>
            <Anchor To="https://blazestack.blazorforest.com/" Target="Target.Blank" Class="b-visual-button b-visual-button-outline">Live preview</Anchor>
        </Actions>
    </MarketingPageHeader>
    <section class="b-visual-section">
        <Container>
            <Div Class="b-theme-feature">
                <Anchor To="themes/blazestack" Class="b-theme-feature-image">
                    <Image Source="img/themes/blazestack/dashboard-small.jpg" Text="BlazeStack admin dashboard preview" Fluid Loading />
                </Anchor>
                <Div Class="b-theme-feature-copy">
                    <Paragraph Class="b-visual-eyebrow">ADMIN &amp; DASHBOARD</Paragraph>
                    <Heading Size="HeadingSize.Is2">Meet BlazeStack.</Heading>
                    <Paragraph TextColor="TextColor.Muted">A responsive Blazorise administrator dashboard built on Bootstrap, Bulma, and AntDesign. Explore the design, then choose the license that fits your project.</Paragraph>
                    <Div Flex="Flex.Column" Gap="Gap.Is3">
                        <Button Type="ButtonType.Link" To="themes/blazestack" Color="Color.Primary">Open theme page</Button>
                        <Anchor To="https://blazestack.blazorforest.com/" Target="Target.Blank">Try the live preview <Span aria-hidden="true">&#8599;</Span></Anchor>
                    </Div>
                </Div>
            </Div>
        </Container>
    </section>
</Div>