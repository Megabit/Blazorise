@page "/features"

<Seo Canonical="/features" Title="Blazorise Features" Description="Build production-ready Blazor applications with a complete UI component system, responsive utilities, design-system theming, validation, localization, and source-available flexibility." />

<Div Class="b-visual b-marketing b-expanded-page b-features-page b-decorated-page">
    <FeatureProductIntro />

    <section class="b-visual-section b-editorial-facts">
        <FeatureFactsSection />
    </section>

    <section class="b-visual-section b-decorated-section">
        <SectionDecoration Variant="BrandBackdropVariant.Circuit" Placement="SectionDecorationPlacement.Bottom" Size="SectionDecorationSize.Large" Opacity="0.5" />
        <FeaturePlatformSection />
    </section>

    <section class="b-visual-section b-marketing-tint">
        <FeatureCapabilitiesSection />
    </section>

    <section class="b-visual-section b-decorated-section">
        <SectionDecoration Variant="BrandBackdropVariant.EdgeArcs" Side="SectionDecorationSide.Left" Placement="SectionDecorationPlacement.Top" Opacity="0.6" />
        <FeatureUtilitiesSection />
    </section>

    <section class="b-visual-section b-feature-support">
        <Div Class="b-feature-support-art" aria-hidden="true">
            <BrandBackdrop Variant="BrandBackdropVariant.PetalFan" Dark />
        </Div>
        <FeatureLicenseSection />
