@page "/indie"
@using Blazorise.Docs.Models

<Seo Canonical="/indie" Title="Blazorise Indie | Project licensing" Description="Build and sell your own Blazor application. Indie covers one developer and one registered project when the organization's total annual revenue is below €25,000." />

<Div Class="b-visual b-marketing b-expanded-page">
    <MarketingPageHeader Variant="BrandBackdropVariant.CircleScatter" Counterpoint="BrandBackdropVariant.CircleScatter">
        <Title>Blazorise Indie for<br /><Span>solo developers</Span></Title>
        <Description>Build and sell your own Blazor application with an annual license for one registered project.</Description>
        <Actions>
            <Anchor To="#purchase-indie" Class="b-visual-button b-visual-button-primary">Get Indie</Anchor>
            <Anchor To="docs/start" Class="b-visual-button b-visual-button-outline">Get started</Anchor>
        </Actions>
    </MarketingPageHeader>

    <Container Padding="Padding.Is5.OnY">
        <Row Gutter="Gutter.Is4">
            <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                <Heading Size="HeadingSize.Is2">Who Indie is for</Heading>
                <Paragraph>
                    Indie covers personal and commercial products, including a side project or a SaaS application you sell to customers. Both eligibility requirements apply.
                </Paragraph>
                <UnorderedList>
                    <UnorderedListItem>You own the product and are its only developer.</UnorderedListItem>
                    <UnorderedListItem>Your business or organization has total annual revenue below €25,000 across all its products and services.</UnorderedListItem>
                </UnorderedList>
                <Paragraph>
                    For client projects, agency work, or internal company applications, choose Professional or Enterprise. This applies even if you are the only developer.
                </Paragraph>

                <Heading Size="HeadingSize.Is2">What is included</Heading>
                <Paragraph>
                    Your Indie product token removes the evaluation component limits and licensing banner for your registered project. Your subscription includes regular component updates.
                </Paragraph>
                <Paragraph>
                    Community support is available through <Anchor To="https://github.com/Megabit/Blazorise/issues">GitHub Issues</Anchor>, where you can report bugs and suggest improvements. Professional and Enterprise include dedicated technical support.
                </Paragraph>

                <Heading Size="HeadingSize.Is2">When your project grows</Heading>
                <Paragraph>
                    If your organization's total annual revenue reaches €25,000, upgrade to Professional at your next renewal.
                </Paragraph>
                <Paragraph>
                    If another developer joins the project or you need dedicated support, choose Professional. Each licensed developer can work on unlimited projects. <Anchor To="mailto:sales@blazorise.com">Contact sales</Anchor> to upgrade.
                </Paragraph>

            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
                <Div ElementId="purchase-indie">
                    <PricingCard PlanName="Indie" PlanDescription="One developer. One independently owned project." Quantity="1" QuantityUnit="project" PlanPrice="@CommercialPriceList.IndieAnnual.Price" ReferencePrice="@CommercialPriceList.IndieAnnual" PlanUnit="year" CurrencySymbol="€" CurrencyCode="EUR" ShowPlan TextAccentColor="TextColor.Default">
                        <ChildContent>
                            <Paragraph>
                                For solo developers whose business or organization has total annual revenue below €25,000. Includes regular updates and community support.
                            </Paragraph>
                            <Paragraph TextSize="TextSize.Small" TextColor="TextColor.Muted">
                                Billed annually per registered project. Checkout taxes depend on your location and tax status. <Anchor To="/pricing/price-list" Title="View the Blazorise price list">Price list</Anchor>.
                            </Paragraph>
                        </ChildContent>
                        <ButtonContent>
                            <PurchaseButton Color="Color.Primary" ProductId="@PaddlePrices.IndieYearlySubscriptionPerProject" Quantity="1" ProductName="Blazorise Indie">
                                Buy Indie
                            </PurchaseButton>
                        </ButtonContent>
                    </PricingCard>
                </Div>
            </Column>
        </Row>
        <Paragraph Margin="Margin.Is4.FromTop">
            <Anchor To="pricing">Compare all plans</Anchor> or read the <Anchor To="docs/usage/licensing">licensing guide</Anchor>.
        </Paragraph>
    </Container>
</Div>