@page "/custom-work"

<Seo Canonical="/custom-work" Title="Blazor Consulting, Expert Support, and Custom Work" Description="Get hands-on Blazorise support from a Blazor expert, or choose Feature Sponsorship, Custom Development, and Priority Development Queue services for larger work." />

<PageHeader>
    <Title>
        Blazorise <Span Class="gradient-commercial">Custom Work</Span>
    </Title>
    <Subtitle>
        Blazor consulting, live expert support, and custom development
    </Subtitle>
    <Description>
        <Paragraph>
            Choose hands-on Blazorise support for focused technical help, or a custom work engagement when you need larger implementation work or a feature delivered sooner. Each option is separate from the normal asynchronous support included with applicable commercial licenses.
        </Paragraph>
    </Description>
    <Actions>
        <Button Type="ButtonType.Link" To="custom-work/quote" Color="Color.Primary" Size="Size.Large" Padding="Padding.Is4.OnX">
            <Icon Name="IconName.PaperPlane" />
            Request a Quote
        </Button>
        <Button Type="ButtonType.Link" To="commercial" Color="Color.Light" Size="Size.Large" Padding="Padding.Is4.OnX">
            <Icon Name="IconName.Briefcase" />
            Commercial Overview
        </Button>
    </Actions>
</PageHeader>

<Container>
    <CustomWorkOptions ShowHeader="false" />
</Container>