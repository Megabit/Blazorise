@namespace Blazorise.Docs.Docs.Examples

<Field>
    <FieldLabel>
        Volume
    </FieldLabel>
    <FieldBody>
        <Slider TValue="int" @bind-Value="@volume" Max="100" Step="5" Orientation="Orientation.Vertical" />
    </FieldBody>
    <FieldHelp>
        Current volume: @volume%
    </FieldHelp>
</Field>

@code {
    private int volume = 40;
}