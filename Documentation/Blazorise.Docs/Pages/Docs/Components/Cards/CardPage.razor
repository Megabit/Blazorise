@page "/docs/components/card"

<Seo Canonical="/docs/components/card" Title="Blazorise Card component" Description="The Blazorise Card component is a versatile component that can be used for anything from a panel to a static image." />

<DocsPageTitle Path="Components/Card">
    Blazorise Card component
</DocsPageTitle>

<DocsPageLead>
    Group related information and actions in a flexible content container.
</DocsPageLead>

<DocsPageParagraph>
    Use the <Code>Card</Code> component for summaries, product previews, profiles, and other content that benefits from a clear visual boundary.
</DocsPageParagraph>

<DocsPageSectionTitle>
    Structure
</DocsPageSectionTitle>

<DocsPageParagraph>
    A <Code>Card</Code> can combine a header, image, body, and footer. Add the parts your content needs.
</DocsPageParagraph>

<DocsAnatomy Label="Card component anatomy">
    <DocsAnatomyRegion Label="Card" Description="Contains related content and actions.">
        <DocsAnatomyRegion Label="CardHeader" Description="An optional header." />
        <DocsAnatomyRegion Label="CardImage" Description="An optional image." />
        <DocsAnatomyRegion Label="CardBody" Description="The main content area.">
            <DocsAnatomyRegion Label="CardTitle" Description="A title for the content." />
            <DocsAnatomyRegion Label="CardSubtitle" Description="An optional subtitle." />
            <DocsAnatomyRegion Label="CardText" Description="Descriptive text." />
        </DocsAnatomyRegion>
        <DocsAnatomyRegion Label="CardFooter" Description="An optional footer for actions or supporting information." />
    </DocsAnatomyRegion>
</DocsAnatomy>

<DocsPageParagraph>
    Wrap multiple cards in <Code>CardGroup</Code> to join them together, or <Code>CardDeck</Code> to arrange them with equal width and height.
</DocsPageParagraph>

