<DocsPageTitle Path="Components/Figure">
    Blazorise Figure component
</DocsPageTitle>

<DocsPageLead>
    Keep an image and its caption together as a single piece of content.
</DocsPageLead>

<DocsPageParagraph>
    Use the <Code>Figure</Code> component for illustrations, photographs, or diagrams that need a related caption.
</DocsPageParagraph>

<DocsPageSectionTitle>
    Structure
</DocsPageSectionTitle>

<DocsPageParagraph>
    A <Code>Figure</Code> groups an image with an optional caption.
</DocsPageParagraph>

<DocsAnatomy Label="Figure component anatomy">
    <DocsAnatomyRegion Label="Figure" Description="Groups the image and caption.">
        <DocsAnatomyRegion Label="FigureImage" Description="The image to display." />
        <DocsAnatomyRegion Label="FigureCaption" Description="An optional caption." />
    </DocsAnatomyRegion>
</DocsAnatomy>

