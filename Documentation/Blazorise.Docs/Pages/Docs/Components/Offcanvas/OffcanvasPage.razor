<DocsPageTitle Path="Components/Offcanvas" AddedVersion="1.3" AddedDate="2023-08-06">
    Blazorise Offcanvas component
</DocsPageTitle>

<DocsPageLead>
    Reveal supporting content in a panel that slides in from the edge of the page.
</DocsPageLead>

<DocsPageParagraph>
    Use the <Code>Offcanvas</Code> component for navigation, shopping carts, filters, or details that users need alongside the current view.
</DocsPageParagraph>

<DocsPageSectionTitle>
    Structure
</DocsPageSectionTitle>

<DocsPageParagraph>
    An <Code>Offcanvas</Code> panel can contain a header, body, and footer.
</DocsPageParagraph>

<DocsAnatomy Label="Offcanvas component anatomy">
    <DocsAnatomyRegion Label="Offcanvas" Description="Controls the panel and its visibility.">
        <DocsAnatomyRegion Label="OffcanvasHeader" Description="The heading area." />
        <DocsAnatomyRegion Label="OffcanvasBody" Description="The main panel content." />
        <DocsAnatomyRegion Label="OffcanvasFooter" Description="An optional area for actions or supporting information." />
    </DocsAnatomyRegion>
</DocsAnatomy>

