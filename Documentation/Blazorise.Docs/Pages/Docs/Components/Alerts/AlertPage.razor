@page "/docs/components/alert"

<Seo Canonical="/docs/components/alert" Title="Blazorise Alert component" Description="Learn to work with the Blazorise Alert component, which is used to convey important information to the user through the use of contextual types, icons, and colors." />

<DocsPageTitle Path="Components/Alert">
    Blazorise Alert component
</DocsPageTitle>

<DocsPageLead>
    Draw attention to important information with contextual feedback messages.
</DocsPageLead>

<DocsPageParagraph>
    Use the <Code>Alert</Code> component for confirmations, warnings, and errors that users need to notice within a page.
</DocsPageParagraph>

<DocsPageSectionTitle>
    Structure
</DocsPageSectionTitle>

<DocsPageParagraph>
    An <Code>Alert</Code> contains a message, an optional description, and an optional close button.
</DocsPageParagraph>

<DocsAnatomy Label="Alert component anatomy">
    <DocsAnatomyRegion Label="Alert" Description="Contains the feedback message.">
        <DocsAnatomyRegion Label="AlertMessage" Description="The main message." />
        <DocsAnatomyRegion Label="AlertDescription" Description="Optional supporting details." />
        <DocsAnatomyRegion Label="CloseButton" Description="An optional control for dismissing the alert." />
    </DocsAnatomyRegion>
</DocsAnatomy>

<DocsPageSectionTitle>
    When to use
</DocsPageSectionTitle>

<UnorderedList>
    <UnorderedListItem>
        When you need to show alert messages to users.
    </UnorderedListItem>
    <UnorderedListItem>
        When you need a persistent static container which is closable by user actions.
    </UnorderedListItem>
</UnorderedList>

