<Seo Canonical="/docs/components/breadcrumb" Title="Blazorise Breadcrumb component" Description="Learn to use and work with the Blazorise Breadcrumbs component, which indicates the current page's location." />

<DocsPageTitle Path="Components/Breadcrumb">
    Blazorise Breadcrumb component
</DocsPageTitle>

<DocsPageLead>
    Help users see where they are and return to a parent page.
</DocsPageLead>

<DocsPageParagraph>
    Use breadcrumbs for pages within a hierarchy, such as product categories, documentation sections, or nested administration screens.
</DocsPageParagraph>

<DocsPageParagraph>
    You can inform the current page using the <Code>Active</Code> attribute in a <Code>BreadcrumbItem</Code>.
</DocsPageParagraph>

<DocsPageSectionTitle>
    Structure
</DocsPageSectionTitle>

<DocsPageParagraph>
    A <Code>Breadcrumb</Code> contains items for the current page and its ancestors. Each item can include a link to its destination.
</DocsPageParagraph>

<DocsAnatomy Label="Breadcrumb component anatomy">
    <DocsAnatomyRegion Label="Breadcrumb" Description="Contains the navigation trail.">
        <DocsAnatomyRegion Label="BreadcrumbItem" Description="One location in the trail; can mark the current page.">
            <DocsAnatomyRegion Label="BreadcrumbLink" Description="A link to the destination page." />
        </DocsAnatomyRegion>
    </DocsAnatomyRegion>
</DocsAnatomy>

<DocsPageSectionTitle>
    Examples
</DocsPageSectionTitle>

<DocsPageSection>
    <DocsPageSectionHeader Title="Manual mode">
        This is the default mode. Meaning you need to set <Code>BreadcrumbItem.Active</Code> property implicitly.
    </DocsPageSectionHeader>
    <DocsPageSectionContent Code="BreadcrumbManualExample" Outlined>
        <BreadcrumbManualExample />
    </DocsPageSectionContent>
</DocsPageSection>

<DocsPageSection>
