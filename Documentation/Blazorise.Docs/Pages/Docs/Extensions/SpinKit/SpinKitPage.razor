@page "/docs/extensions/spinkit"

<Seo Canonical="/docs/extensions/spinkit" Title="Blazorise SpinKit component" Description="Learn how to use the Blazorise SpinKit component to show CSS-based loading indicators with multiple animation styles, colors, sizes, and loading states." />

<DocsPageTitle Path="Extensions/SpinKit">
    Blazorise SpinKit component
</DocsPageTitle>

<DocsPageLead>
    Show lightweight, CSS-based loading indicators.
</DocsPageLead>

<DocsPageParagraph>
    To use the <Code>SpinKit</Code> component, install the <Code>Blazorise.SpinKit</Code> package first.
</DocsPageParagraph>

<DocsPageSectionTitle>
    Installation
</DocsPageSectionTitle>

<DocsPageSection>
    <DocsPageSectionHeader Title="NuGet">
        Install extension from NuGet.
    </DocsPageSectionHeader>
    <DocsPageSectionSource Code="SpinKitNugetInstallExample" />
</DocsPageSection>

<DocsPageSection>
    <DocsPageSectionHeader Title="Imports">
        In your main <Badge Color="Color.Light">_Imports.razor</Badge> add:
    </DocsPageSectionHeader>
    <DocsPageSectionSource Code="SpinKitImportsExample" />
</DocsPageSection>

<DocsPageSection>
    <DocsPageSectionHeader Title="Static files">
        Add these links inside the <Code Tag>head</Code> section:
    </DocsPageSectionHeader>
    <DocsPageSectionSourceGroup AriaLabel="Blazor project type">
        <DocsPageSectionSource Code="SpinKitResourcesExample" CodeTitle="WebAssembly">
            Update <Code>wwwroot/index.html</Code>.
        </DocsPageSectionSource>
        <DocsPageSectionSource Code="SpinKitResourcesExample" CodeTitle="Blazor Server">
            Update <Code>_Layout.cshtml</Code> or <Code>_Host.cshtml</Code>, depending on your project template.
        </DocsPageSectionSource>
        <DocsPageSectionSource Code="SpinKitResourcesExample" CodeTitle="Blazor Web App">
            Update <Code>Components/App.razor</Code> in the server project.
        </DocsPageSectionSource>
    </DocsPageSectionSourceGroup>
</DocsPageSection>

