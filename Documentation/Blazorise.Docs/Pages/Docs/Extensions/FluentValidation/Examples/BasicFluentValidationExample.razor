@namespace Blazorise.Docs.Docs.Examples
@using Blazorise.FluentValidation

<Validations @ref="@fluentValidations" Mode="ValidationMode.Manual" Model="@person" HandlerType="typeof(FluentValidationHandler)">
    <Validation>
        <Field>
            <FieldLabel>First name</FieldLabel>
            <FieldBody>
                <TextInput Placeholder="Enter first name..." @bind-Value="@person.FirstName">
                    <Feedback>
                        <ValidationError />
                    </Feedback>
                </TextInput>
            </FieldBody>
        </Field>
    </Validation>
    <Validation>
        <Field>
            <FieldLabel>Last name</FieldLabel>
            <FieldBody>
                <TextInput Placeholder="Enter last name..." @bind-Value="@person.LastName">
                    <Feedback>
                        <ValidationError />
                    </Feedback>
                </TextInput>
            </FieldBody>
        </Field>
    </Validation>
    <Validation>
        <Field>
            <FieldLabel>Age</FieldLabel>
            <FieldBody>
                <NumericInput Placeholder="Enter age..." @bind-Value="@person.Age">
                    <Feedback>
                        <ValidationError />
                    </Feedback>
                </NumericInput>
            </FieldBody>
        </Field>
    </Validation>
</Validations>

<Button Color="Color.Primary" Clicked="@OnSavePerson">Save</Button>

@code {
    Validations fluentValidations;

    Person person = new();

    protected async Task OnSavePerson()
    {
        if ( await fluentValidations.ValidateAll() )
        {
            // the person is validated and we can proceed with the saving process
        }
    }
}