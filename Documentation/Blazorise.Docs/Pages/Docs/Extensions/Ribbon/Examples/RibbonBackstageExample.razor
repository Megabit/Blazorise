@namespace Blazorise.Docs.Docs.Examples

<RibbonWorkspace Border="Border.Is1.Rounded" Height="Height.Rem( 24 )">
    <Ribbon SelectedTab="home" ShowCollapseButton="false">
        <RibbonApplicationTab>
            <RibbonApplicationButton Text="File" />
        </RibbonApplicationTab>
        <RibbonTabs>
            <RibbonTab Name="home" Text="Home">
                <RibbonGroup Text="Clipboard">
                    <RibbonButton Text="Paste" Icon="IconName.Paste" Size="RibbonItemSize.Large" />
                    <RibbonColumn>
                        <RibbonButton Text="Cut" Icon="IconName.Cut" />
                        <RibbonButton Text="Copy" Icon="IconName.Copy" Clicked="@OnCopyHandler" />
                        <RibbonButton Text="Format Painter" Icon="IconName.PaintBrush" />
                    </RibbonColumn>
                </RibbonGroup>
                <RibbonGroup Text="Paragraph">
                    <RibbonButton Text="Align left" Icon="IconName.AlignLeft" Size="RibbonItemSize.Large" />
                    <RibbonColumn>
                        <RibbonButton Text="Center" Icon="IconName.AlignCenter" />
                        <RibbonButton Text="Align right" Icon="IconName.AlignRight" />
                    </RibbonColumn>
                </RibbonGroup>
                <RibbonGroup Text="Editing">
                    <RibbonColumn>
                        <RibbonButton Text="Find" Icon="IconName.Search" />
                        <RibbonButton Text="Replace" Icon="IconName.Sync" />
                    </RibbonColumn>
                </RibbonGroup>
            </RibbonTab>
        </RibbonTabs>
    </Ribbon>
    <Div Padding="Padding.Is4">
        <Heading Size="HeadingSize.Is4">Quarterly report</Heading>
        <Paragraph>Open File to view document information or choose a save format.</Paragraph>
        <MemoInput @bind-Value="@documentText" Rows="3" aria-label="Document text" />
    </Div>
    <RibbonBackstage @ref="@backstageRef" @bind-SelectedItem="@selectedItem">
        <RibbonBackstageItem Name="info" Text="Info" Icon="IconName.InfoCircle">
            <Heading Size="HeadingSize.Is4">Document information</Heading>
            <Paragraph>Quarterly report</Paragraph>
            <Paragraph TextColor="TextColor.Secondary">Author: Alex Morgan. Status: Ready for review.</Paragraph>
        </RibbonBackstageItem>
        <RibbonBackstageItem Name="save-as" Text="Save As" Icon="IconName.Save">
            <Heading Size="HeadingSize.Is4">Save a copy</Heading>
            <Div Flex="Flex.Row.Wrap" Gap="Gap.Is2">
                <Button Color="Color.Primary" Clicked="@OnSaveWordHandler">Word document</Button>
                <Button Color="Color.Secondary" Clicked="@OnSavePdfHandler">PDF</Button>
            </Div>
        </RibbonBackstageItem>
        <RibbonBackstageItem Name="save" Text="Save" Icon="IconName.Save" Clicked="@OnSaveHandler" />
    </RibbonBackstage>
</RibbonWorkspace>

<Paragraph Margin="Margin.Is2.FromTop" TextColor="TextColor.Secondary">
    @status
</Paragraph>

@code {
    private RibbonBackstage backstageRef;

    private string selectedItem = "info";

    private string documentText = "Edit this document, then open and close File. Your content stays in place.";

    private string status = "The document workspace is visible.";

    private void OnCopyHandler()
    {
        status = "Copy selected.";
    }

    private async Task OnSaveHandler()
    {
        status = "Save command selected.";

        await backstageRef.Hide();
    }

    private async Task OnSaveWordHandler()
    {
        status = "Save as Word document selected.";

        await backstageRef.Hide();
    }

    private async Task OnSavePdfHandler()
    {
        status = "Save as PDF selected.";

        await backstageRef.Hide();
    }
}