@namespace Blazorise.Docs.Docs.Examples

<Ribbon SelectedTab="home" ShowCollapseButton="false" Border="Border.Is1.Rounded">
    <RibbonApplicationTab>
        <RibbonApplicationMenu Text="File">
            <RibbonApplicationMenuItem Text="New" Icon="IconName.File" Clicked="@OnNewHandler" />
            <RibbonApplicationMenuItem Text="Open" Icon="IconName.FolderOpen" Clicked="@OnOpenHandler" />
            <RibbonApplicationMenuItem Text="Save As" Icon="IconName.Save">
                <RibbonApplicationMenuItem Text="Word document" Clicked="@OnSaveWordHandler" />
                <RibbonApplicationMenuItem Text="PDF" Clicked="@OnSavePdfHandler" />
                <RibbonApplicationMenuDivider />
                <RibbonApplicationMenuItem Text="Other formats">
                    <RibbonApplicationMenuItem Text="Plain text" Clicked="@OnSaveTextHandler" />
                </RibbonApplicationMenuItem>
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuDivider />
            <RibbonApplicationMenuItem Text="Print" Icon="IconName.Print" Clicked="@OnPrintHandler" />
        </RibbonApplicationMenu>
    </RibbonApplicationTab>
    <RibbonTabs>
        <RibbonTab Name="home" Text="Home">
            <RibbonGroup Text="Clipboard">
                <RibbonButton Text="Paste" Icon="IconName.Paste" Size="RibbonItemSize.Large" />
                <RibbonColumn>
                    <RibbonButton Text="Cut" Icon="IconName.Cut" />
                    <RibbonButton Text="Copy" Icon="IconName.Copy" Clicked="@OnCopyHandler" />
                    <RibbonButton Text="Format Painter" Icon="IconName.PaintBrush" />
                </RibbonColumn>
            </RibbonGroup>
            <RibbonGroup Text="Paragraph">
                <RibbonButton Text="Align left" Icon="IconName.AlignLeft" Size="RibbonItemSize.Large" />
                <RibbonColumn>
                    <RibbonButton Text="Center" Icon="IconName.AlignCenter" />
                    <RibbonButton Text="Align right" Icon="IconName.AlignRight" />
                </RibbonColumn>
            </RibbonGroup>
            <RibbonGroup Text="Editing">
                <RibbonColumn>
                    <RibbonButton Text="Find" Icon="IconName.Search" />
                    <RibbonButton Text="Replace" Icon="IconName.Sync" />
                </RibbonColumn>
            </RibbonGroup>
        </RibbonTab>
    </RibbonTabs>
</Ribbon>

<Paragraph Margin="Margin.Is2.FromTop" TextColor="TextColor.Secondary">
    @status
</Paragraph>

@code {
    private string status = "Open File, then Save As to explore nested menus.";

    private void OnNewHandler()
    {
        status = "New document selected.";
    }

    private void OnOpenHandler()
    {
        status = "Open document selected.";
    }

    private void OnSaveWordHandler()
    {
        status = "Save as Word document selected.";
    }

    private void OnSavePdfHandler()
    {
        status = "Save as PDF selected.";
    }

    private void OnSaveTextHandler()
    {
        status = "Save as plain text selected.";
    }

    private void OnPrintHandler()
    {
        status = "Print selected.";
    }

    private void OnCopyHandler()
    {
        status = "Copy selected.";
    }
}