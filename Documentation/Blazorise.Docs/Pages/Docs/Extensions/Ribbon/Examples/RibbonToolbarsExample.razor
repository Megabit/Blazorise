@namespace Blazorise.Docs.Docs.Examples

<Ribbon @bind-SelectedTab="@selectedTab" Border="Border.Is1.Rounded">
    <QuickAccessContent>
        <RibbonButton Text="Save" Icon="IconName.Save" Size="RibbonItemSize.Small" Clicked="@OnSaveHandler" />
        <RibbonButton Text="Undo" Icon="IconName.Undo" Size="RibbonItemSize.Small" Clicked="@OnUndoHandler" />
        <RibbonButton Text="Redo" Icon="IconName.Redo" Size="RibbonItemSize.Small" Clicked="@OnRedoHandler" />
    </QuickAccessContent>
    <TabStripContent>
        <RibbonButton Text="Comments" Icon="IconName.Comment" Clicked="@OnCommentsHandler" />
        <RibbonDropdown Text="Share" Icon="IconName.ShareAlt" Size="RibbonItemSize.Medium">
            <RibbonDropdownItem Text="Share document" Clicked="@OnShareHandler" />
            <RibbonDropdownItem Text="Copy link" Clicked="@OnCopyLinkHandler" />
        </RibbonDropdown>
    </TabStripContent>
    <RibbonTabs>
        <RibbonTab Name="home" Text="Home">
            <RibbonGroup Text="Clipboard">
                <RibbonButton Text="Paste" Icon="IconName.Paste" Size="RibbonItemSize.Large" />
                <RibbonColumn>
                    <RibbonButton Text="Cut" Icon="IconName.Cut" />
                    <RibbonButton Text="Copy" Icon="IconName.Copy" />
                    <RibbonButton Text="Format Painter" Icon="IconName.PaintBrush" />
                </RibbonColumn>
            </RibbonGroup>
            <RibbonGroup Text="Editing">
                <RibbonColumn>
                    <RibbonButton Text="Find" Icon="IconName.Search" />
                    <RibbonButton Text="Replace" Icon="IconName.Sync" />
                </RibbonColumn>
            </RibbonGroup>
        </RibbonTab>
        <RibbonTab Name="insert" Text="Insert">
            <RibbonGroup Text="Illustrations">
                <RibbonButton Text="Picture" Icon="IconName.Image" Size="RibbonItemSize.Large" />
                <RibbonColumn>
                    <RibbonButton Text="Chart" Icon="IconName.ChartBar" />
                    <RibbonButton Text="Screenshot" Icon="IconName.Camera" />
                </RibbonColumn>
            </RibbonGroup>
            <RibbonGroup Text="Links">
                <RibbonButton Text="Link" Icon="IconName.Link" Size="RibbonItemSize.Large" />
                <RibbonButton Text="Bookmark" Icon="IconName.Bookmark" />
            </RibbonGroup>
        </RibbonTab>
    </RibbonTabs>
</Ribbon>

<Paragraph Margin="Margin.Is2.FromTop" TextColor="TextColor.Secondary">
    @status
</Paragraph>

@code {
    private string selectedTab = "home";

    private string status = "Try the toolbar commands, then switch tabs or collapse the ribbon.";

    private void OnSaveHandler()
    {
        status = "Save selected.";
    }

    private void OnUndoHandler()
    {
        status = "Undo selected.";
    }

    private void OnRedoHandler()
    {
        status = "Redo selected.";
    }

    private void OnCommentsHandler()
    {
        status = "Comments selected.";
    }

    private void OnShareHandler()
    {
        status = "Share document selected.";
    }

    private void OnCopyLinkHandler()
    {
        status = "Copy link selected.";
    }
}