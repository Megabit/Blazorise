<DocsPageSubsectionTitle ElementId="api-pdfdocumentbuilder">
    PdfDocumentBuilder
</DocsPageSubsectionTitle>

<DocsMethods Name="Method" Title="Methods">
    <DocsMethodsItem Name="Create" ReturnType="PdfDocumentBuilder">
        Creates a new fluent PDF document builder.
    </DocsMethodsItem>
    <DocsMethodsItem Name="Title" ReturnType="PdfDocumentBuilder" Parameters="string title">
        Sets the document title.
    </DocsMethodsItem>
    <DocsMethodsItem Name="AddFont" ReturnType="PdfDocumentBuilder" Parameters="FontFamily font, or a name and font sources">
        Adds a document-scoped font family.
    </DocsMethodsItem>
    <DocsMethodsItem Name="PageSetup" ReturnType="PdfDocumentBuilder" Parameters="PdfPageSize size, PdfOrientation orientation = Portrait, double width = 0, double height = 0">
        Sets the default size and orientation for document pages.
    </DocsMethodsItem>
    <DocsMethodsItem Name="Page" ReturnType="PdfDocumentBuilder" Parameters="Action&lt;PdfPageBuilder&gt; configure">
        Adds and configures a page. Overloads can set the page size, orientation, width, and height.
    </DocsMethodsItem>
    <DocsMethodsItem Name="Build" ReturnType="PdfDocumentDefinition">
        Builds the document definition used by the PDF generator.
    </DocsMethodsItem>
</DocsMethods>

<DocsPageSubsectionTitle ElementId="api-ipdfgenerator">
    IPdfGenerator
</DocsPageSubsectionTitle>

<DocsMethods Name="Method" Title="Methods">
    <DocsMethodsItem Name="GenerateAsync" ReturnType="Task&lt;PdfGenerationResult&gt;" Parameters="PdfDocumentDefinition document, PdfGenerationOptions options = null, CancellationToken cancellationToken = default">
        Generates a complete PDF document in memory.
    </DocsMethodsItem>
    <DocsMethodsItem Name="GenerateToStreamAsync" ReturnType="Task" Parameters="PdfDocumentDefinition document, Stream stream, PdfGenerationOptions options = null, CancellationToken cancellationToken = default">
        Generates a PDF directly into the supplied stream and leaves the stream open.
    </DocsMethodsItem>
</DocsMethods>