  <Import Project="../../Build/Blazorise.Docs.Generation.targets" />

  <ItemGroup>
    <Compile Remove="ApiDocs/**/*.cs;Models/Snippets.generated.cs" />
    <!-- Blog markup is maintained separately. Compiler-generated examples are embedded from obj. -->
    <EmbeddedResource Include="Pages/**/*.html" Exclude="Pages/Docs/**/*Code.html" />
  </ItemGroup>

  <!-- Read the complete current manifest rather than globbing stale output from deleted examples. -->
  <Target Name="IncludeGeneratedDocs" BeforeTargets="AssignTargetPaths"
          DependsOnTargets="InitializeDocsGeneration;CompileDocs">
    <Error Condition="'$(DesignTimeBuild)' != 'true' and (!Exists('$(DocsGeneratedOutputPath)/ExampleCodeFiles.txt') or !Exists('$(DocsGeneratedOutputPath)/Models/Snippets.generated.cs'))"
           Text="Generated documentation is missing. Build with GenerateDocs=true first." />

    <ReadLinesFromFile File="$(DocsGeneratedOutputPath)/ExampleCodeFiles.txt"
                       Condition="Exists('$(DocsGeneratedOutputPath)/ExampleCodeFiles.txt')">
      <Output TaskParameter="Lines" ItemName="_GeneratedExampleCode" />
    </ReadLinesFromFile>

    <ItemGroup>
      <EmbeddedResource Remove="@(_GeneratedExampleCode)" />
      <EmbeddedResource Include="@(_GeneratedExampleCode->'$(DocsGeneratedOutputPath)/%(Identity)')">
        <Link>%(_GeneratedExampleCode.Identity)</Link>
        <LogicalName>$(RootNamespace).$([System.String]::Copy('%(_GeneratedExampleCode.Identity)').Replace('/', '.'))</LogicalName>
      </EmbeddedResource>
      <Compile Include="$(DocsGeneratedOutputPath)/Models/Snippets.generated.cs"
               Condition="Exists('$(DocsGeneratedOutputPath)/Models/Snippets.generated.cs')" />
      <Compile Include="$(ApiDocsIntermediatePath)/**/*.ApiDocs.cs" />
      <FileWrites Include="$(DocsGeneratedOutputPath)/**/*;$(ApiDocsIntermediatePath)/**/*.ApiDocs.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Remove="Pages\Docs\Extensions\Reporting\Examples\StatusBadgeReportElementPropertiesExample.razor" />
    <Content Remove="Pages\Docs\Extensions\Reporting\Examples\StatusBadgeReportElementRendererExample.razor" />
  </ItemGroup>
