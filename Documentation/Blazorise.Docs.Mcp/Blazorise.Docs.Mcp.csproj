<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <GenerateDocsSearchDataOnly>true</GenerateDocsSearchDataOnly>

    <!-- Set up the NuGet package to be an MCP server -->
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>

    <!-- Set up the MCP server to be a self-contained application that does not rely on a shared framework -->
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>

    <!-- Set up the MCP server to be a single file executable -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Set recommended package metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>SampleMcpServer</PackageId>
    <PackageVersion>0.1.0-beta</PackageVersion>
    <PackageTags>AI; MCP; server; stdio</PackageTags>
    <Description>An MCP server using the MCP C# SDK.</Description>
  </PropertyGroup>

  <!-- Include additional files for browsing the MCP server. -->
  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <Import Project="../../Build/Blazorise.Docs.Generation.targets" />

  <Target Name="IncludeGeneratedDocsIndexes" BeforeTargets="AssignTargetPaths;_GetPackageFiles"
          DependsOnTargets="InitializeDocsGeneration;CompileDocs">
    <Error Condition="'$(DesignTimeBuild)' != 'true' and (!Exists('$(DocsGeneratedOutputPath)/Resources/docs-index.json') or !Exists('$(DocsGeneratedOutputPath)/Resources/docs-api-index.json'))"
           Text="Generated documentation indexes are missing. Build with GenerateDocs=true first." />

    <ItemGroup>
      <Content Include="$(DocsGeneratedOutputPath)/Resources/docs*-index.json"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest"
               Pack="true"
               PackagePath="/">
        <Link>%(Filename)%(Extension)</Link>
        <TargetPath>%(Filename)%(Extension)</TargetPath>
      </Content>
      <FileWrites Include="$(DocsGeneratedOutputPath)/**/*" />
    </ItemGroup>
  </Target>

</Project>