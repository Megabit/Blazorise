<MemoInput id="memo-autosize" AutoSize="@autoSize" Rows="2" @bind-Value="value" />

<Button id="memo-set-long-value" Clicked="@SetLongValue">Set long value</Button>
<Button id="memo-toggle-autosize" Clicked="@ToggleAutoSize">Toggle auto size</Button>

<Div ElementId="memo-editing">
    <MemoInput ElementId="memo-replace-tab" ReplaceTab="@replaceTab" TabSize="@tabSize" SoftTabs="@softTabs" ReadOnly="@readOnly" Immediate="@replaceTabImmediate" Value="@replaceTabValue" ValueChanged="@OnReplaceTabValueChangedHandler" KeyPress="@OnEditingKeyPressHandler" />
    <Span ElementId="memo-replace-tab-result" data-value="@replaceTabValue" data-keypress-count="@keyPressCount">@replaceTabChangedCount</Span>
    <Button ElementId="memo-toggle-immediate" Clicked="@OnToggleImmediateHandler">Immediate: @replaceTabImmediate</Button>
    <Button ElementId="memo-toggle-replace-tab" Clicked="@OnToggleReplaceTabHandler">Replace tab: @replaceTab</Button>
    <Button ElementId="memo-change-tab-size" Clicked="@OnChangeTabSizeHandler">Tab size: @tabSize</Button>
    <Button ElementId="memo-toggle-soft-tabs" Clicked="@OnToggleSoftTabsHandler">Soft tabs: @softTabs</Button>
    <Button ElementId="memo-toggle-readonly" Clicked="@OnToggleReadOnlyHandler">Readonly: @readOnly</Button>
</Div>

@code {
    private bool replaceTab = true;
    private int tabSize = 4;
    private bool softTabs = true;
    private bool readOnly;

    private bool replaceTabImmediate = true;
    private string replaceTabValue = string.Empty;
    private int replaceTabChangedCount;
    private int keyPressCount;

    private bool autoSize = true;
    private string value = "Short value";

    private void OnReplaceTabValueChangedHandler( string value )
    {
        replaceTabValue = value;
        replaceTabChangedCount++;
    }

    private void OnEditingKeyPressHandler()
    {
        keyPressCount++;
    }

    private void OnToggleImmediateHandler()
    {
        replaceTabImmediate = !replaceTabImmediate;
    }

    private void OnToggleReplaceTabHandler()
    {
        replaceTab = !replaceTab;
    }

    private void OnChangeTabSizeHandler()
    {
        tabSize = 2;
    }

    private void OnToggleSoftTabsHandler()
    {
        softTabs = !softTabs;
    }

    private void OnToggleReadOnlyHandler()
    {
        readOnly = !readOnly;
    }

    private void SetLongValue()
    {
        value = string.Join( Environment.NewLine, Enumerable.Repeat( "A line of programmatically supplied text.", 8 ) );
    }

    private void ToggleAutoSize()
    {
        autoSize = !autoSize;
    }
}