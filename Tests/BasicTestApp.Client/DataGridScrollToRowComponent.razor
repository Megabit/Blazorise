<Switch ElementId="groupHeaders" @bind-Value="groupHeaders">Group headers</Switch>
<Switch ElementId="virtualize" @bind-Value="virtualize">Virtualize</Switch>
<Switch ElementId="manualRead" @bind-Value="manualRead">Read data</Switch>

<DataGrid @ref="dataGrid"
          @key="(virtualize, manualRead)"
          ElementId="scrollGrid"
          TItem="ScrollItem"
          Data="@(manualRead ? loadedItems : items)"
          ReadData="@(manualRead ? OnReadData : null)"
          TotalItems="@(manualRead ? items.Count : null)"
          Virtualize="virtualize"
          VirtualizeOptions="@(new() { DataGridHeight = "250px", DataGridMaxHeight = "250px", OverscanCount = 3 })"
          PageSize="30"
          FixedHeader
          FixedHeaderDataGridMaxHeight="200px"
          ShowHeaderGroupCaptions="groupHeaders"
          @bind-SelectedRow="selectedRow">
    <DataGridColumns>
        <DataGridColumn Field="@nameof( ScrollItem.Id )" Caption="Id" HeaderGroupCaption="Item" />
        <DataGridColumn Field="@nameof( ScrollItem.Name )" Caption="Name" HeaderGroupCaption="Item" />
    </DataGridColumns>
</DataGrid>

@foreach ( var index in new[] { 0, 5, 6, 10, 20, 29, 40, 500, 999 } )
{
    <Button ElementId="@($"scrollTo{index}")" Clicked="@(() => ScrollToRow( index ))">Scroll to @index</Button>
}

@code {
    private DataGrid<ScrollItem> dataGrid;
    private ScrollItem selectedRow;
    private bool groupHeaders;

    private bool virtualize;

    private bool manualRead;

    private IEnumerable<ScrollItem> loadedItems = [];

    private readonly List<ScrollItem> items = Enumerable.Range( 0, 1000 )
        .Select( index => new ScrollItem { Id = index, Name = $"Item {index}" } )
        .ToList();

    private Task OnReadData( DataGridReadDataEventArgs<ScrollItem> eventArgs )
    {
        var startIndex = eventArgs.ReadDataMode == DataGridReadDataMode.Virtualize
            ? eventArgs.VirtualizeOffset
            : ( eventArgs.Page - 1 ) * eventArgs.PageSize;

        var count = eventArgs.ReadDataMode == DataGridReadDataMode.Virtualize
            ? eventArgs.VirtualizeCount
            : eventArgs.PageSize;

        loadedItems = items.Skip( startIndex ).Take( count ).ToList();

        return Task.CompletedTask;
    }

    private async Task ScrollToRow( int index )
    {
        selectedRow = items[index];
        await dataGrid.ScrollToRow( index );
    }

    public class ScrollItem
    {
        public int Id { get; set; }

        public string Name { get; set; }
    }
}